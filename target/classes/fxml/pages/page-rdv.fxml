<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxWidth="1140" spacing="10" styleClass="rdv-page"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PageRdvController">
    <!-- Carte principale : filtres + liste (sans bandeau hero / titre) -->
    <VBox maxWidth="Infinity" spacing="0" styleClass="rdv-content-card">
    <HBox alignment="TOP_LEFT" spacing="28" styleClass="rdv-two-col">
        <!-- Colonne filtres -->
        <VBox minWidth="260" prefWidth="300" spacing="16" styleClass="rdv-filters-panel">
            <Label styleClass="rdv-filters-title" text="Filtres" />
            <VBox spacing="6">
                <Label styleClass="rdv-filter-label" text="Spécialité" />
                <ComboBox maxWidth="Infinity" promptText="Toutes les spécialités" styleClass="rdv-combo">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Toutes les spécialités" />
                            <String fx:value="Psychologue" />
                            <String fx:value="Pédopsychiatre" />
                            <String fx:value="Orthophoniste" />
                            <String fx:value="Ergothérapeute" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
            <VBox spacing="6">
                <Label styleClass="rdv-filter-label" text="Lieu" />
                <TextField promptText="Ville ou adresse..." styleClass="rdv-field" />
            </VBox>
            <VBox spacing="10" styleClass="rdv-help-box">
                <Label styleClass="rdv-help-title" text="Besoin d'aide ?" />
                <Label styleClass="rdv-help-text" text="Choisissez un professionnel, puis cliquez sur « Prendre RDV ». Vous pourrez sélectionner une date et un créneau à l'étape suivante." wrapText="true" />
            </VBox>
        </VBox>

        <!-- Liste des professionnels -->
        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="12" styleClass="rdv-main-col">
            <Label styleClass="rdv-results-count" text="2 professionnel(s) disponible(s)" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="Infinity" minViewportHeight="420" prefViewportHeight="480" styleClass="rdv-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <VBox spacing="14" styleClass="rdv-list">
                    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="rdv-pro-card">
                        <StackPane prefHeight="64" prefWidth="64" styleClass="rdv-pro-avatar">
                            <Label styleClass="rdv-pro-avatar-text" text="LA" />
                        </StackPane>
                        <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="rdv-pro-info">
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="rdv-pro-name-row">
                                <Label styleClass="rdv-pro-name" text="Dr. Landoulsi Ameni" />
                                <Label styleClass="rdv-pro-tag" text="Spécialiste" />
                                <Label styleClass="rdv-pro-stars" text="☆☆☆☆☆" />
                            </HBox>
                            <Label styleClass="rdv-pro-detail" text="Cabinet AutiCare Bardo · Accompagnement neurodéveloppemental" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="rdv-pro-meta-row">
                                <Label styleClass="rdv-pro-chip" text="🏢 Cabinet" />
                                <Label styleClass="rdv-pro-location" text="📍 Bardo" />
                            </HBox>
                        </VBox>
                        <VBox alignment="TOP_RIGHT" spacing="10" styleClass="rdv-pro-actions">
                            <Label styleClass="rdv-pro-phone" text="📞 22 243 529" />
                            <Label styleClass="rdv-pro-price" text="50 DT" />
                            <Button mnemonicParsing="false" onAction="#onPrendreRdvLandoulsi" styleClass="rdv-pro-cta home-btn-soft" text="Prendre RDV  →" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="rdv-pro-card">
                        <StackPane prefHeight="64" prefWidth="64" styleClass="rdv-pro-avatar">
                            <Label styleClass="rdv-pro-avatar-text" text="SE" />
                        </StackPane>
                        <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="rdv-pro-info">
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="rdv-pro-name-row">
                                <Label styleClass="rdv-pro-name" text="Dr. Selma Essefi" />
                                <Label styleClass="rdv-pro-tag" text="Spécialiste" />
                                <Label styleClass="rdv-pro-stars" text="☆☆☆☆☆" />
                            </HBox>
                            <Label styleClass="rdv-pro-detail" text="Centre bien-être El Ghazela · Suivi familles &amp; enfants" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="rdv-pro-meta-row">
                                <Label styleClass="rdv-pro-chip" text="🏢 Cabinet" />
                                <Label styleClass="rdv-pro-location" text="📍 El Ghazela" />
                            </HBox>
                        </VBox>
                        <VBox alignment="TOP_RIGHT" spacing="10" styleClass="rdv-pro-actions">
                            <Label styleClass="rdv-pro-phone" text="📞 23 19 88 13" />
                            <Label styleClass="rdv-pro-price" text="45 DT" />
                            <Button mnemonicParsing="false" onAction="#onPrendreRdvEssefi" styleClass="rdv-pro-cta home-btn-soft" text="Prendre RDV  →" />
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
    </VBox>
</VBox>
