                        </HBox>
                    </VBox>
                </VBox>

                <HBox alignment="CENTER" maxWidth="Infinity" spacing="12" styleClass="admin-form-actions">
                    <Button onAction="#onSaveNewEvent" styleClass="admin-new-event-btn-primary" text="Enregistrer l'événement"/>
                    <Button onAction="#onCloseNewEventForm" styleClass="admin-new-event-btn-secondary" text="Annuler"/>
                </HBox>
                </VBox>
            </VBox>
            </VBox>
            </StackPane>
        </AnchorPane>

        <VBox fx:id="eventDetailLayer" managed="false" minWidth="720" spacing="18" styleClass="admin-event-detail-root" visible="false" maxWidth="1280" prefWidth="1220" StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets bottom="24" left="24" right="24" top="16"/>
            </StackPane.margin>
            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onCloseEventDetail" styleClass="admin-new-event-back-link" text="← Retour aux événements"/>
                <Button mnemonicParsing="false" onAction="#onDetailEdit" styleClass="admin-new-event-btn-outline-blue" text="Modifier"/>
                <Button fx:id="detailSendRemindersButton" mnemonicParsing="false" onAction="#onDetailSendReminders" styleClass="admin-event-detail-remind-btn" text="📧  Envoyer les rappels par e-mail"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <VBox spacing="12" styleClass="admin-event-detail-card">
                <Label fx:id="detailTitleLabel" styleClass="admin-event-detail-title" text="—" wrapText="true"/>
                <Label fx:id="detailMetaLabel" styleClass="admin-event-detail-meta" text="" wrapText="true"/>
                <Separator/>
                <Label styleClass="admin-new-event-label" text="Description"/>
                <Label fx:id="detailDescriptionLabel" styleClass="admin-event-detail-body" wrapText="true" text=""/>
            </VBox>
            <VBox fx:id="detailParticipantsCard" spacing="10" styleClass="admin-event-detail-card">
