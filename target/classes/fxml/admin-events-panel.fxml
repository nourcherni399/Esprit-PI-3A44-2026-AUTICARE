                                            </VBox>
                                        </HBox>
                                        <HBox spacing="10">
                                            <VBox styleClass="admin-world-ai-insight-card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="admin-world-ai-insight-title" text="👥 Public cible"/>
                                                <Label fx:id="worldAiTrendAudience" styleClass="admin-world-ai-insight-text" text="—" wrapText="true"/>
                                            </VBox>
                                            <VBox styleClass="admin-world-ai-insight-card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="admin-world-ai-insight-title" text="📍 Localisation"/>
                                                <Label fx:id="worldAiTrendLocation" styleClass="admin-world-ai-insight-text" text="—" wrapText="true"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="8" styleClass="admin-world-ai-card-box">
                                        <Label styleClass="admin-world-ai-card-title" text="Idée d’événement générée par IA"/>
                                        <VBox spacing="8">
                                            <Label styleClass="admin-new-event-label" text="Choisir un titre proposé (max 1)"/>
                                            <VBox fx:id="worldAiTitleChoicesBox" spacing="6"/>
                                            <Label styleClass="admin-new-event-label" text="Choisir une description proposée (max 1)"/>
                                            <VBox fx:id="worldAiDescriptionChoicesBox" spacing="6"/>
                                        </VBox>
                                        <GridPane hgap="10" vgap="10">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                                            </columnConstraints>
                                            <Label styleClass="admin-new-event-label" text="Titre"/>
                                            <TextField fx:id="worldAiFormTitle" GridPane.columnIndex="1" styleClass="admin-new-event-input"/>

                                            <Label styleClass="admin-new-event-label" text="Description" GridPane.rowIndex="1"/>
                                            <TextArea fx:id="worldAiFormDescription" prefRowCount="4" styleClass="admin-new-event-textarea" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                            <Label styleClass="admin-new-event-label" text="Public cible" GridPane.rowIndex="2"/>
                                            <TextField fx:id="worldAiFormAudience" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="admin-new-event-input"/>
                                        </GridPane>
                                    </VBox>

                                    <VBox spacing="8" styleClass="admin-world-ai-card-box">
                                        <Label styleClass="admin-world-ai-card-title" text="Score de succès"/>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label fx:id="worldAiScoreLabel" styleClass="admin-world-ai-score" text="0%"/>
                                            <ProgressBar fx:id="worldAiScoreProgress" prefWidth="340" progress="0.0"/>
                                        </HBox>
                                        <Label fx:id="worldAiScoreHint" styleClass="admin-events-stat-warn" text="Basé sur les tendances actuelles"/>
                                    </VBox>

                                    <VBox spacing="8" styleClass="admin-world-ai-card-box">
                                        <Label styleClass="admin-world-ai-card-title" text="Recommandations IA"/>
                                        <VBox fx:id="worldAiRecommendationsBox" spacing="6"/>
                                    </VBox>

                                    <Label fx:id="worldAiWhySuggestionLabel" managed="false" styleClass="admin-world-ai-why" visible="false" wrapText="true"/>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </StackPane>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button mnemonicParsing="false" onAction="#onCreateAiSuggestedEvent" styleClass="admin-world-search-submit" text="Créer cet événement"/>
                        <Button mnemonicParsing="false" onAction="#onExplainWorldSearchSuggestion" styleClass="admin-world-search-ai-btn" text="🤖 Pourquoi cette suggestion ?"/>
                    </HBox>
                </VBox>
            </StackPane>
        </AnchorPane>
    </StackPane>
</ScrollPane>
