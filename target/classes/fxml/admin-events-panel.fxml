                    <Button mnemonicParsing="false" onAction="#onDetailExportParticipantsPdf" styleClass="admin-event-detail-pdf-btn" text="Liste des participants (PDF)"/>
                </HBox>
                <Separator/>
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-event-participants-head">
                        <Label text="Participant" styleClass="admin-event-participants-head-cell" prefWidth="190" alignment="CENTER_LEFT" textAlignment="LEFT" style="-fx-font-weight: 700;"/>
                        <Label text="Email" styleClass="admin-event-participants-head-cell" prefWidth="230" alignment="CENTER_LEFT" textAlignment="LEFT" style="-fx-font-weight: 700;"/>
                        <Label text="Date demande" styleClass="admin-event-participants-head-cell" prefWidth="180" alignment="CENTER_LEFT" textAlignment="LEFT" style="-fx-font-weight: 700;"/>
                        <Label text="Statut" styleClass="admin-event-participants-head-cell" prefWidth="130" alignment="CENTER" textAlignment="CENTER" style="-fx-font-weight: 700;"/>
                        <Label text="Actions" styleClass="admin-event-participants-head-cell" prefWidth="220" alignment="CENTER" textAlignment="CENTER" style="-fx-font-weight: 700;"/>
                    </HBox>
                    <VBox fx:id="detailParticipantsTableBox" spacing="6"/>
                    <Label fx:id="detailParticipantsBody" styleClass="admin-event-detail-placeholder" text="Aucun participant pour le moment" wrapText="true"/>
                </VBox>
            </VBox>
            <VBox fx:id="detailDiscussionCard" spacing="10" styleClass="admin-event-detail-card">
                <HBox alignment="TOP_LEFT" spacing="12">
                    <StackPane styleClass="admin-event-detail-chat-badge" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                        <Label text="💬" styleClass="admin-event-detail-chat-badge-ico"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label styleClass="admin-event-detail-card-title" text="Discussions avec les participants"/>
                        <Label styleClass="admin-event-detail-sub" text="Répondez aux messages des utilisateurs."/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailUnreadBadgeLabel" managed="false" styleClass="admin-event-detail-unread-badge" text="0 message(s) non lu(s)" visible="false"/>
                </HBox>
                <Separator/>
                <HBox fx:id="detailDiscussionContentBox" alignment="TOP_LEFT" spacing="16">
                    <VBox spacing="8" prefWidth="300" minWidth="260">
                        <Label styleClass="admin-event-detail-list-title" text="CONVERSATIONS"/>
                        <VBox fx:id="detailConversationsListBox" spacing="8" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="admin-event-detail-conv-right">
                        <VBox fx:id="detailConversationPlaceholderBox" alignment="CENTER" spacing="10" styleClass="admin-event-detail-empty-chat" VBox.vgrow="ALWAYS">
                            <Label text="💬" styleClass="admin-event-detail-big-ico"/>
                            <Label fx:id="detailDiscussionBody" styleClass="admin-event-detail-placeholder" text="Sélectionnez une conversation dans la liste."/>
                        </VBox>
                        <VBox fx:id="detailConversationPanelBox" managed="false" spacing="12" visible="false" VBox.vgrow="ALWAYS">
                            <VBox spacing="2">
                                <Label fx:id="detailSelectedConversationTitle" styleClass="admin-event-detail-conv-title" text="Conversation"/>
                                <Label fx:id="detailSelectedConversationSub" styleClass="admin-event-detail-conv-sub" text=""/>
                            </VBox>
                            <ScrollPane fx:id="detailConversationMessagesScroll" fitToWidth="true" hbarPolicy="NEVER" minHeight="280" prefHeight="380" styleClass="admin-event-detail-msg-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="detailConversationMessagesBox" spacing="10"/>
                                </content>
                            </ScrollPane>
                            <VBox spacing="6">
                                <Label styleClass="admin-new-event-label" text="Votre réponse *"/>
