                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Button mnemonicParsing="false" onAction="#onDetailSendReply" styleClass="admin-event-detail-send-btn" text="➤  Envoyer la réponse"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <AnchorPane fx:id="worldSearchAiHost" managed="false" maxHeight="Infinity" maxWidth="Infinity" styleClass="admin-world-ai-dim" visible="false" StackPane.alignment="TOP_LEFT">
            <StackPane maxHeight="Infinity" maxWidth="Infinity" styleClass="admin-world-ai-dim" alignment="CENTER"
                       AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
