<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.geometry.Pos?>

<ScrollPane fx:id="eventsScrollRoot" fitToWidth="true" hbarPolicy="NEVER" styleClass="admin-events-scroll-root" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.AdminEventsPanelController"
            stylesheets="@../styles/app.css">
    <StackPane fx:id="eventsStackPane" alignment="TOP_CENTER" maxWidth="Infinity">
        <VBox fx:id="eventsListLayer" spacing="16" styleClass="admin-events-tab-root">
            <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>
            <VBox spacing="4">
                <Label styleClass="admin-events-main-title" text="Gestion des événements"/>
                <Label styleClass="admin-events-main-sub" text="Recherchez, triez et gérez vos événements."/>
                <Label fx:id="checkinServerHintLabel" managed="false" maxWidth="920" styleClass="admin-events-main-sub" text="" visible="false" wrapText="true"/>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-events-toolbar">
                <TextField fx:id="searchField" prefWidth="420" promptText="Titre, lieu, thématique ou date" styleClass="admin-events-field"/>
                <ComboBox fx:id="sortOrderBox" prefWidth="120" promptText="Ordre" styleClass="admin-events-combo"/>
                <Button mnemonicParsing="false" onAction="#onAdvancedSearch" styleClass="admin-events-btn-advanced" text="Recherche avancée">
                    <tooltip>
                        <Tooltip text="Aller au panneau de recherche web (événements réels) sous le tableau."/>
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#onNewEvent" styleClass="admin-events-btn-new" text="+ Nouvel élément"/>
                <Region HBox.hgrow="ALWAYS" minWidth="8"/>
            </HBox>
            <TableView fx:id="adminEventsTable" styleClass="admin-events-table">
                <placeholder>
                    <Label styleClass="admin-events-table-placeholder" text="Aucun événement"/>
                </placeholder>
            </TableView>
            <VBox fx:id="worldSearchSection" maxWidth="Infinity" spacing="12" styleClass="admin-events-world-search">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-events-world-search-hero">
                    <Label text="Recherche avancée — événements dans le monde" styleClass="admin-events-world-search-title" wrapText="true"/>
                </HBox>
                <VBox spacing="10" styleClass="admin-events-world-search-form">
                    <HBox alignment="BASELINE_LEFT" maxWidth="Infinity" spacing="14" styleClass="admin-world-search-row">
                        <VBox minWidth="220" spacing="6" HBox.hgrow="SOMETIMES">
                            <Label styleClass="admin-new-event-label" text="Mots-clés (thème, lieu, type)"/>
                            <TextField fx:id="worldSearchKeywords" maxWidth="Infinity" promptText="ex. éducation Tunisie" styleClass="admin-new-event-input"/>
                        </VBox>
                        <VBox minWidth="140" spacing="6" prefWidth="200">
                            <Label styleClass="admin-new-event-label" text="Période"/>
                            <ComboBox fx:id="worldSearchPeriod" maxWidth="Infinity" prefWidth="200" styleClass="admin-new-event-input"/>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#onWorldWebSearch" text="Rechercher dans le monde" styleClass="admin-world-search-submit"/>
                    </HBox>
                    <Label fx:id="worldSearchHintLabel" managed="false" maxWidth="Infinity" styleClass="admin-events-stat-warn" visible="false" wrapText="true"/>
                    <ScrollPane fx:id="worldSearchScroll" fitToWidth="true" hbarPolicy="NEVER" maxHeight="320" minHeight="100" vbarPolicy="AS_NEEDED" styleClass="admin-world-search-scroll">
                        <content>
                        <VBox fx:id="worldSearchResultsBox" maxWidth="Infinity" spacing="8" styleClass="admin-world-search-results"/>
                        </content>
                    </ScrollPane>
                    <Button fx:id="worldSearchAiButton" managed="false" minHeight="40" mnemonicParsing="false" onAction="#onWorldSearchAi" styleClass="admin-world-search-ai-btn" text="✨  Analyser et proposer des idées avec l'IA" visible="false" wrapText="true"/>
                </VBox>
            </VBox>
            <HBox alignment="TOP_LEFT" spacing="16" styleClass="admin-events-charts-row">
                <VBox spacing="10" styleClass="admin-events-chart-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="admin-events-chart-title" text="Répartition des événements par période"/>
                    <StackPane minHeight="220" prefHeight="240" maxHeight="Infinity" maxWidth="Infinity" styleClass="admin-events-pie-placeholder" VBox.vgrow="ALWAYS">
                        <PieChart fx:id="piePeriodChart" labelsVisible="false" legendSide="BOTTOM" legendVisible="true"
                                  minHeight="190" prefHeight="210" maxWidth="Infinity" maxHeight="Infinity"/>
                    </StackPane>
                </VBox>
                <VBox spacing="10" styleClass="admin-events-chart-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="admin-events-chart-title" text="Répartition des inscriptions"/>
                    <StackPane minHeight="220" prefHeight="240" maxHeight="Infinity" maxWidth="Infinity" styleClass="admin-events-pie-placeholder" VBox.vgrow="ALWAYS">
                        <PieChart fx:id="pieRegsChart" labelsVisible="false" legendSide="BOTTOM" legendVisible="true"
                                  minHeight="190" prefHeight="210" maxWidth="Infinity" maxHeight="Infinity"/>
                    </StackPane>
                </VBox>
            </HBox>
            <HBox alignment="TOP_LEFT" spacing="12" styleClass="admin-events-stats-row">
                <VBox spacing="8" styleClass="admin-events-stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="admin-events-stat-title" text="Événements par période"/>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="À venir"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBadgePeriodVenir" styleClass="admin-stat-num-badge admin-stat-num-badge-orange" text="0"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="Passés"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBadgePeriodPasses" styleClass="admin-stat-num-badge admin-stat-num-badge-blue" text="0"/>
                    </HBox>
                </VBox>
                <VBox spacing="8" styleClass="admin-events-stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="admin-events-stat-title" text="Inscriptions par statut"/>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="Acceptées"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBadgeInscAccept" styleClass="admin-stat-num-badge admin-stat-num-badge-green" text="0"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="En attente"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBadgeInscAttente" styleClass="admin-stat-num-badge admin-stat-num-badge-orange" text="0"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="Refusées"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBadgeInscRefus" styleClass="admin-stat-num-badge admin-stat-num-badge-red" text="0"/>
                    </HBox>
                </VBox>
                <VBox spacing="8" styleClass="admin-events-stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="admin-events-stat-title" text="Statistiques générales"/>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="Total des événements"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBigTotal" styleClass="admin-stat-num-badge admin-stat-num-badge-blue" text="0"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="À venir"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBigVenir" styleClass="admin-stat-num-badge admin-stat-num-badge-green" text="0"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-stat-row-badge">
                        <Label styleClass="admin-events-stat-line" text="Total inscriptions"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Label fx:id="statBigInscTotal" styleClass="admin-stat-num-badge admin-stat-num-badge-purple" text="0"/>
                    </HBox>
                </VBox>
            </HBox>
            <VBox spacing="14" styleClass="admin-events-stat-card admin-ideas-card">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label style="-fx-font-size:16px; -fx-font-weight:900; -fx-text-fill:#1e1b4b;" styleClass="admin-new-event-label admin-ideas-collecte-label" text="Collecte"/>
                    <ComboBox fx:id="ideaCollectionDayBox" minWidth="220" prefWidth="280" promptText="Jour de collecte" styleClass="admin-events-combo admin-ideas-collecte-combo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#onRefreshIdeasDashboard" styleClass="admin-new-event-btn-outline-blue" text="↻ Actualiser"/>
                    <Button fx:id="ideaAnalyzeButton" mnemonicParsing="false" onAction="#onGenerateIdeasRecommendation" style="-fx-background-color:#fef3c7; -fx-text-fill:#92400e; -fx-border-color:#f59e0b; -fx-border-width:2; -fx-border-radius:10; -fx-background-radius:10; -fx-font-weight:800;" styleClass="admin-ideas-analyze-mauve" text="✨ Analyser avec l'IA"/>
                    <ProgressIndicator fx:id="ideaAnalyzeProgress" managed="false" maxHeight="22" maxWidth="22" prefHeight="22" prefWidth="22" progress="-1.0" visible="false"/>
                </HBox>
                <Label styleClass="admin-ideas-section-title" text="Statistiques principales"/>
                <GridPane hgap="10" styleClass="admin-ideas-kpi-grid" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    </columnConstraints>
                    <VBox alignment="TOP_CENTER" spacing="6" styleClass="admin-ideas-kpi-chip admin-ideas-kpi-chip-blue" GridPane.columnIndex="0">
                        <HBox alignment="CENTER" spacing="6">
                            <Label styleClass="admin-ideas-kpi-icon" text="📥"/>
                            <Label styleClass="admin-events-stat-line admin-ideas-kpi-title" text="Total propositions"/>
                        </HBox>
                        <Label fx:id="ideaTotalLabel" alignment="CENTER" maxWidth="Infinity" styleClass="admin-ideas-kpi-value" text="0"/>
                    </VBox>
                    <VBox alignment="TOP_CENTER" spacing="6" styleClass="admin-ideas-kpi-chip admin-ideas-kpi-chip-green" GridPane.columnIndex="1">
                        <HBox alignment="CENTER" spacing="6">
                            <Label styleClass="admin-ideas-kpi-icon" text="🏆"/>
                            <Label styleClass="admin-events-stat-line admin-ideas-kpi-title" text="Thème dominant"/>
                        </HBox>
                        <Label fx:id="ideaTopThemeLabel" alignment="CENTER" maxWidth="Infinity" styleClass="admin-ideas-kpi-value" text="—"/>
                    </VBox>
                    <VBox alignment="TOP_CENTER" spacing="6" styleClass="admin-ideas-kpi-chip admin-ideas-kpi-chip-purple" GridPane.columnIndex="2">
                        <HBox alignment="CENTER" spacing="6">
                            <Label styleClass="admin-ideas-kpi-icon" text="🧩"/>
                            <Label styleClass="admin-events-stat-line admin-ideas-kpi-title" text="Format dominant"/>
                        </HBox>
                        <Label fx:id="ideaTopFormatLabel" alignment="CENTER" maxWidth="Infinity" styleClass="admin-ideas-kpi-value" text="—"/>
                    </VBox>
                    <VBox alignment="TOP_CENTER" spacing="6" styleClass="admin-ideas-kpi-chip admin-ideas-kpi-chip-orange" GridPane.columnIndex="3">
                        <HBox alignment="CENTER" spacing="6">
                            <Label styleClass="admin-ideas-kpi-icon" text="🗂"/>
                            <Label styleClass="admin-events-stat-line admin-ideas-kpi-title" text="Groupes similaires"/>
                        </HBox>
                        <Label fx:id="ideaClusterCountLabel" alignment="CENTER" maxWidth="Infinity" styleClass="admin-ideas-kpi-value" text="0"/>
                    </VBox>
                </GridPane>
                <VBox spacing="8" styleClass="admin-ideas-content-box admin-ideas-live-box">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="admin-ideas-section-title" text="✨ Analyse détaillée"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="ideaToggleExplainButton" mnemonicParsing="false" onAction="#onToggleIdeasExplanation" styleClass="admin-new-event-btn-outline-blue" text="Mode explication IA"/>
                    </HBox>
                    <Label styleClass="admin-ideas-reco-label" text="🧠 Cluster principal"/>
                    <TextFlow fx:id="ideaMainClusterFlow" maxWidth="Infinity" prefWidth="Infinity"/>
                    <TextFlow fx:id="ideaExplainFlow" managed="false" maxWidth="Infinity" prefWidth="Infinity" styleClass="admin-ideas-explain-box" visible="false"/>
                    <Label styleClass="admin-ideas-section-title" text="💬 Propositions analysées"/>
                    <VBox fx:id="ideaSubmittedExamplesBox" spacing="6"/>
                    <Label styleClass="admin-ideas-section-title" text="📐 Formules de calcul"/>
                    <TextFlow fx:id="ideaFormulaFlow" managed="false" maxWidth="Infinity" prefWidth="Infinity" styleClass="admin-ideas-formula-box" visible="false"/>
                </VBox>
                <HBox alignment="TOP_LEFT" spacing="12">
                    <VBox spacing="8" styleClass="admin-ideas-content-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="admin-ideas-section-title" text="Répartition des thèmes"/>
                        <PieChart fx:id="ideaThemePieChart" labelsVisible="false" legendVisible="false" minHeight="120" prefHeight="140"/>
                        <VBox fx:id="ideaThemeBarsBox" spacing="8"/>
                    </VBox>
                    <VBox spacing="8" styleClass="admin-ideas-content-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="admin-ideas-section-title" text="Répartition des formats"/>
                        <FlowPane fx:id="ideaFormatChipsBox" hgap="8" prefWrapLength="440" vgap="8"/>
                    </VBox>
                </HBox>
                <VBox spacing="8" styleClass="admin-ideas-reco-card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="admin-ideas-ai-icon" text="🤖"/>
                        <Label styleClass="admin-ideas-section-title" text="Recommandation IA"/>
                        <Label fx:id="ideaConfidenceBadgeLabel" styleClass="admin-ideas-confidence-badge" text="Confiance IA: —"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="ideaEditRecommendationBtn" mnemonicParsing="false" onAction="#onEditIdeasRecommendation" styleClass="admin-new-event-btn-outline-blue" text="✎ Modifier"/>
                        <Button fx:id="ideaCreateEventBtn" mnemonicParsing="false" onAction="#onCreateEventFromIdeasRecommendation" styleClass="admin-new-event-btn-outline-blue" text="Créer cet événement"/>
                    </HBox>
                    <VBox spacing="8" styleClass="admin-ideas-reco-body">
                        <Label styleClass="admin-ideas-reco-label" text="📌 Titre"/>
                        <Label fx:id="ideaRecoTitleLabel" maxWidth="Infinity" styleClass="admin-ideas-reco-value-strong" text="—" wrapText="true"/>
                        <Label styleClass="admin-ideas-reco-label" text="📝 Description"/>
                        <Label fx:id="ideaRecoDescriptionLabel" maxWidth="Infinity" styleClass="admin-ideas-reco-value" text="—" wrapText="true"/>
                        <Label styleClass="admin-ideas-reco-label" text="💡 Pourquoi"/>
                        <Label fx:id="ideaRecoWhyLabel" maxWidth="Infinity" styleClass="admin-ideas-reco-value" text="—" wrapText="true"/>
                        <Label styleClass="admin-ideas-reco-label" text="✅ Recommandations"/>
                        <VBox fx:id="ideaRecoRecommendationsBox" spacing="4"/>
                    </VBox>
                    <Label fx:id="ideaAiRecommendationLabel" managed="false" maxWidth="Infinity" styleClass="admin-world-ai-insight-text admin-ideas-reco admin-ideas-raw" text="" visible="false" wrapText="true"/>
                </VBox>
            </VBox>
        </VBox>

        <AnchorPane fx:id="newEventFormHost" managed="false" maxHeight="Infinity" maxWidth="Infinity" visible="false" StackPane.alignment="CENTER">
            <StackPane alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity"
                       AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox fx:id="newEventFormLayer" alignment="TOP_LEFT" maxHeight="Infinity" minWidth="680" spacing="0" styleClass="admin-new-event-layer">
            <padding><Insets bottom="20" left="0" right="0" top="12"/></padding>
            <VBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="16" styleClass="admin-form-stack-inner" VBox.vgrow="ALWAYS">
                <VBox maxWidth="Infinity" spacing="6" styleClass="admin-form-hero">
                    <Button alignment="BASELINE_LEFT" onAction="#onCloseNewEventForm" styleClass="admin-new-event-back-link" text="← Retour aux événements"/>
                    <Label fx:id="formPageTitle" styleClass="admin-new-event-h1" text="Nouvel événement"/>
                </VBox>

                <VBox spacing="16" maxWidth="Infinity" styleClass="admin-form-white-sheet">
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity" styleClass="admin-form-card">
                    <Label styleClass="admin-form-section-title" text="Informations générales"/>
                    <VBox spacing="6" maxWidth="Infinity">
                        <Label styleClass="admin-new-event-label" text="Titre *"/>
                        <TextField fx:id="formTitre" maxWidth="Infinity" promptText="Lettres uniquement — ex. Atelier sensoriel" styleClass="admin-new-event-input"/>
                    </VBox>
                    <VBox spacing="8" maxWidth="Infinity">
                        <Label styleClass="admin-form-section-title" text="Thématique"/>
                        <Label styleClass="admin-new-event-label" text="Thématique *"/>
                        <ComboBox fx:id="formThematique" editable="true" maxWidth="Infinity" promptText="Choisir ou saisir une thématique" styleClass="admin-new-event-input"/>
                    </VBox>
                    <VBox spacing="6" maxWidth="Infinity">
                        <Label styleClass="admin-new-event-label" text="Description *"/>
                        <TextArea fx:id="formDescription" maxWidth="Infinity" prefRowCount="4" promptText="Décrivez l'événement…" styleClass="admin-new-event-textarea" wrapText="true"/>
                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12" styleClass="admin-form-ai-row">
                            <Button onAction="#onFormAiSummarize" styleClass="admin-new-event-btn-outline-green" text="Résumer avec l'IA"/>
                            <Button onAction="#onFormAiSuggest" styleClass="admin-new-event-btn-outline-blue" text="Suggérer une description"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity" styleClass="admin-form-card">
                    <Label styleClass="admin-form-section-title" text="Date et horaires"/>
                    <GridPane hgap="14" maxWidth="Infinity" styleClass="admin-form-datetime-grid" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" minWidth="120" prefWidth="200"/>
                            <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" minWidth="160" prefWidth="260"/>
                            <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" minWidth="160" prefWidth="260"/>
                        </columnConstraints>
                        <VBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label styleClass="admin-new-event-label" text="📅 Date *"/>
                            <DatePicker fx:id="formDate" maxWidth="Infinity" styleClass="admin-new-event-input"/>
                        </VBox>
                        <VBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label styleClass="admin-new-event-label" text="🕐 Heure de début *"/>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="4" styleClass="admin-time-picker">
                                <Spinner fx:id="formHeureDebutHeure" editable="false" maxWidth="Infinity" minWidth="52" prefWidth="64" HBox.hgrow="SOMETIMES" styleClass="admin-time-spinner"/>
                                <Spinner fx:id="formHeureDebutMin" editable="false" maxWidth="Infinity" minWidth="52" prefWidth="64" HBox.hgrow="SOMETIMES" styleClass="admin-time-spinner"/>
                                <ComboBox fx:id="formHeureDebutAmPm" maxWidth="Infinity" minWidth="88" prefWidth="100" HBox.hgrow="ALWAYS" styleClass="admin-new-event-input admin-time-ampm"/>
                            </HBox>
                        </VBox>
                        <VBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label styleClass="admin-new-event-label" text="🕐 Heure de fin *"/>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="4" styleClass="admin-time-picker">
                                <Spinner fx:id="formHeureFinHeure" editable="false" maxWidth="Infinity" minWidth="52" prefWidth="64" HBox.hgrow="SOMETIMES" styleClass="admin-time-spinner"/>
                                <Spinner fx:id="formHeureFinMin" editable="false" maxWidth="Infinity" minWidth="52" prefWidth="64" HBox.hgrow="SOMETIMES" styleClass="admin-time-spinner"/>
                                <ComboBox fx:id="formHeureFinAmPm" maxWidth="Infinity" minWidth="88" prefWidth="100" HBox.hgrow="ALWAYS" styleClass="admin-new-event-input admin-time-ampm"/>
                            </HBox>
                        </VBox>
                    </GridPane>
                </VBox>

                <VBox alignment="TOP_LEFT" spacing="14" maxWidth="Infinity" styleClass="admin-form-card">
                    <Label styleClass="admin-form-section-title" text="Lieu et mode"/>
                    <VBox spacing="6" maxWidth="Infinity">
                        <Label styleClass="admin-new-event-label" text="Mode de l'événement *"/>
                        <ComboBox fx:id="formMode" maxWidth="Infinity" styleClass="admin-new-event-input"/>
                    </VBox>
                    <VBox fx:id="sectionLieuPhysique" maxWidth="Infinity" spacing="12">
                        <VBox spacing="6" maxWidth="Infinity">
                            <Label styleClass="admin-new-event-label" text="Lieu / Adresse *"/>
                            <TextField fx:id="formLieu" maxWidth="Infinity" promptText="Ex. Salle principale" styleClass="admin-new-event-input"/>
                        </VBox>
                        <VBox spacing="6" maxWidth="Infinity">
                            <Label styleClass="admin-new-event-label" text="Lien carte"/>
                            <TextField fx:id="formLienMaps" maxWidth="Infinity" promptText="Collez le lien de la carte" styleClass="admin-new-event-input"/>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="180">
                                <Label styleClass="admin-new-event-label" text="Latitude (carte)"/>
                                <TextField fx:id="formLat" maxWidth="Infinity" promptText="Ex. 36.8065" styleClass="admin-new-event-input"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="180">
                                <Label styleClass="admin-new-event-label" text="Longitude (carte)"/>
                                <TextField fx:id="formLng" maxWidth="Infinity" promptText="Ex. 10.1815" styleClass="admin-new-event-input"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                            <Button onAction="#onFormFetchCoords" styleClass="admin-new-event-btn-coords" text="Récupérer les coordonnées (lieu)" wrapText="true"/>
                        </HBox>
                        <StackPane fx:id="formMapPreviewHost" minHeight="220" prefHeight="260" maxWidth="Infinity" styleClass="event-detail-map-wrap">
                            <Label styleClass="event-detail-map-hint" text="La mini-carte s'affichera ici après récupération des coordonnées." wrapText="true"/>
                        </StackPane>
                    </VBox>
                    <VBox fx:id="sectionVisio" maxWidth="Infinity" spacing="6">
                        <Label styleClass="admin-new-event-label" text="Lien réunion Zoom / visio *"/>
                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                            <TextField fx:id="formLienZoom" maxWidth="Infinity" promptText="Générer automatiquement ou collez un lien" styleClass="admin-new-event-input" HBox.hgrow="ALWAYS"/>
