                                            <Label styleClass="admin-world-ai-card-title" text="Contexte de recherche"/>
                                            <HBox spacing="16">
                                                <Label fx:id="worldAiContextKeyword" styleClass="admin-world-ai-chip" text="Mot-clé : —" wrapText="true"/>
                                                <Label fx:id="worldAiContextPeriod" styleClass="admin-world-ai-chip" text="Période : —"/>
                                                <Label fx:id="worldAiContextCount" styleClass="admin-world-ai-chip" text="Résultats : 0"/>
                                            </HBox>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="10">
                                        <Label styleClass="admin-world-ai-card-title" text="Analyse IA"/>
                                        <HBox spacing="10">
                                            <VBox styleClass="admin-world-ai-insight-card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="admin-world-ai-insight-title" text="🔥 Tendances principales"/>
