                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20"/>
                    </padding>
                    <Button alignment="BASELINE_LEFT" onAction="#onCloseWorldSearchAi" styleClass="admin-new-event-back-link" text="Fermer"/>
                    <VBox spacing="4">
                        <Label styleClass="admin-world-ai-main-title" text="Analyse intelligente des événements"/>
                        <Label styleClass="admin-world-ai-sub-title" text="Découvrez les tendances et créez un événement optimisé"/>
                    </VBox>
                    <HBox spacing="8" styleClass="admin-world-ai-timeline">
                        <Label styleClass="admin-world-ai-step-active" text="Recherche"/>
                        <Label styleClass="admin-world-ai-step-arrow" text="→"/>
                        <Label styleClass="admin-world-ai-step-active" text="Analyse IA"/>
                        <Label styleClass="admin-world-ai-step-arrow" text="→"/>
                        <Label styleClass="admin-world-ai-step-active" text="Idée générée"/>
                        <Label styleClass="admin-world-ai-step-arrow" text="→"/>
                        <Label styleClass="admin-world-ai-step-active" text="Création"/>
                    </HBox>
                    <StackPane fx:id="worldSearchAiStatePane" minHeight="200" VBox.vgrow="ALWAYS">
                        <VBox fx:id="worldSearchAiLoadingBox" alignment="CENTER" spacing="12" styleClass="admin-world-ai-loading">
                            <ProgressIndicator fx:id="worldSearchAiProgress" maxHeight="64" maxWidth="64" prefHeight="64" prefWidth="64" styleClass="admin-world-ai-spinner"/>
                            <Label styleClass="admin-events-main-title" text="Génération des idées en cours…" wrapText="true"/>
                            <Label styleClass="admin-events-stat-warn" text="L’IA prépare des propositions selon votre recherche web." textAlignment="CENTER" wrapText="true"/>
                        </VBox>
                        <ScrollPane fx:id="worldSearchAiContentScroll" fitToWidth="true" hbarPolicy="NEVER" managed="false" styleClass="admin-world-ai-scroll" vbarPolicy="AS_NEEDED" visible="false" StackPane.alignment="TOP_LEFT">
                            <content>
                                <VBox fx:id="worldSearchAiContentRoot" spacing="14">
                                    <HBox spacing="8" styleClass="admin-world-ai-card-box">
                                        <Label styleClass="admin-world-ai-emoji" text="🔍"/>
