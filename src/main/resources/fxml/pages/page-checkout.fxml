<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxWidth="1140" spacing="0" styleClass="checkout-page-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PageCheckoutController">

    <VBox alignment="TOP_CENTER" styleClass="catalog-hero">
        <Label styleClass="public-page-kicker" text="COMMANDE"/>
        <Label styleClass="public-page-title" text="Finaliser votre commande" textAlignment="CENTER" wrapText="true"/>
        <Label styleClass="public-page-lead"
               text="Vos informations de compte sont pré-remplies. Complétez la livraison et choisissez le mode de paiement."
               textAlignment="CENTER" wrapText="true"/>
    </VBox>

    <VBox maxWidth="Infinity" styleClass="rdv-content-card checkout-shell">
        <HBox alignment="TOP_LEFT" spacing="28" styleClass="checkout-split">
            <!-- Colonne gauche : formulaire scrollable + barre d’actions toujours visible -->
            <VBox maxWidth="Infinity" spacing="0" styleClass="checkout-left-stack" HBox.hgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="Infinity" minViewportHeight="500"
                            prefViewportHeight="620" styleClass="catalog-scroll checkout-form-scroll"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <VBox styleClass="checkout-form-column">
                        <VBox styleClass="public-product-form-card checkout-form-inner">
                            <Label styleClass="checkout-form-title" text="Formulaire de livraison et de paiement"/>

                            <Label styleClass="checkout-section-title" text="Informations personnelles"/>
                            <VBox spacing="8">
                                <Label styleClass="checkout-form-label" text="👤  Nom complet"/>
                                <TextField fx:id="fullNameField" promptText="Votre nom complet" styleClass="product-form-input"/>
                            </VBox>
                            <VBox spacing="8">
                                <Label styleClass="checkout-form-label" text="✉  Adresse e-mail"/>
                                <TextField fx:id="emailField" promptText="exemple@gmail.com" styleClass="product-form-input"/>
                            </VBox>
                            <VBox spacing="8">
                                <Label styleClass="checkout-form-label" text="☎  Téléphone"/>
                                <HBox spacing="10">
                                    <ComboBox fx:id="phoneCountryCombo" prefWidth="240" styleClass="product-form-input"/>
                                    <TextField fx:id="phoneField" promptText="XX XXX XXX" styleClass="product-form-input" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>

                            <Separator styleClass="checkout-section-sep"/>

                            <Label styleClass="checkout-section-title" text="Adresse de livraison"/>
                            <VBox spacing="8">
                                <Label styleClass="checkout-form-label" text="📍  Adresse"/>
                                <TextField fx:id="addressField" promptText="Numéro et rue" styleClass="product-form-input"/>
                            </VBox>
                            <HBox spacing="14">
                                <VBox HBox.hgrow="ALWAYS" spacing="8">
                                    <Label styleClass="checkout-form-label" text="🏷  Code postal"/>
                                    <TextField fx:id="zipCodeField" promptText="12345" styleClass="product-form-input"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" spacing="8">
                                    <Label styleClass="checkout-form-label" text="🏙  Ville"/>
                                    <TextField fx:id="cityField" promptText="Votre ville" styleClass="product-form-input"/>
                                </VBox>
                            </HBox>

                            <Separator styleClass="checkout-section-sep"/>

                            <Label styleClass="checkout-section-title" text="Mode de paiement"/>
                            <VBox spacing="10">
                                <Label styleClass="checkout-form-label" text="💳  Choix du paiement"/>
                                <ComboBox fx:id="paymentCombo" maxWidth="Infinity" prefHeight="44" styleClass="product-form-input"/>
                            </VBox>
                            <VBox fx:id="cardFieldsBox" spacing="8" styleClass="checkout-card-fields">
                                <Label styleClass="checkout-field-hint"
                                       text="Paiement carte sur AutiCare : saisissez votre carte ici. Après « Finaliser ma commande », vous enregistrez un fichier Excel récapitulant votre paiement (puis il s’ouvre), et vous recevez un e-mail confirmant le paiement par carte."
                                       wrapText="true"/>
                                <VBox spacing="8">
                                    <Label styleClass="checkout-form-label" text="💳  Numéro de carte"/>
                                    <TextField fx:id="cardNumberField" promptText="16 chiffres (contrôle Luhn)"
                                               styleClass="product-form-input"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label styleClass="checkout-form-label" text="📅  Date d'expiration"/>
                                    <TextField fx:id="cardExpiryField" promptText="MM/AA" styleClass="product-form-input"/>
                                </VBox>
                            </VBox>

                            <Label fx:id="checkoutMessageLabel" managed="false" text="" visible="false"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <VBox spacing="10" styleClass="checkout-actions-bar">
                    <Separator/>
                    <Button defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onConfirmOrder"
                            styleClass="checkout-primary-btn" text="✔ Finaliser ma commande"/>
                    <HBox alignment="CENTER" spacing="10">
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onContinueShopping"
                                styleClass="cart-secondary-btn" text="Continuer les achats" HBox.hgrow="ALWAYS"/>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onBackToCart"
                                styleClass="cart-outline-btn" text="Retour au panier" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Récapitulatif -->
            <VBox minWidth="280" prefWidth="300" spacing="0" styleClass="checkout-order-aside">
                <VBox spacing="12" styleClass="cart-summary-inner checkout-recap-box">
                    <Label styleClass="rdv-filters-title" text="Résumé de la commande"/>
                    <VBox fx:id="checkoutSummaryLines" spacing="6"/>
                    <Separator/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="checkout-summary-key" text="Articles"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="checkoutItemsLabel" styleClass="checkout-summary-value" text="0"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="checkout-summary-key" text="Sous-total"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="checkoutSubtotalLabel" styleClass="checkout-summary-value" text="0.00 DT"/>
                    </HBox>
                    <Separator/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="checkout-summary-total-key" text="Total"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="checkoutTotalLabel" styleClass="checkout-summary-total-value" text="0.00 DT"/>
                    </HBox>
                    <VBox styleClass="checkout-delivery-box">
                        <Label styleClass="checkout-delivery-title" text="Livraison gratuite"/>
                        <Label styleClass="checkout-delivery-text"
                               text="Votre commande sera livrée sous 2 à 3 jours ouvrables." wrapText="true"/>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onExportCheckoutExcel"
                                styleClass="cart-outline-btn" text="Exporter en Excel"/>
                    </VBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</VBox>
