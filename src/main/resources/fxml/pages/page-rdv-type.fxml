<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="rdv-type-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.PageRdvTypeController">
    <Region styleClass="rdv-type-bg"/>

    <VBox maxWidth="1180" spacing="0" styleClass="rdv-type-foreground" StackPane.alignment="TOP_CENTER">
        <padding>
            <Insets bottom="10" left="12" right="12" top="6"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="rdv-booking-topbar">
            <Hyperlink onAction="#onBackToList" styleClass="rdv-booking-back" text="← Retour à la liste"/>
            <Region HBox.hgrow="ALWAYS" minWidth="12"/>
            <HBox fx:id="typeStepperBox" alignment="CENTER_RIGHT" spacing="4" styleClass="rdv-booking-stepper"/>
        </HBox>

        <Region prefHeight="4"/>

        <HBox alignment="TOP_LEFT" spacing="14" styleClass="rdv-booking-main" VBox.vgrow="ALWAYS" maxHeight="Infinity">
            <VBox minWidth="268" prefWidth="300" spacing="8" styleClass="rdv-booking-sidebar">
                <VBox spacing="8" styleClass="rdv-booking-profile-card">
                    <StackPane styleClass="rdv-booking-avatar-wrap">
                        <Label fx:id="typeAvatarInitials" styleClass="rdv-booking-avatar-text" text="DR"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label fx:id="typeSidebarName" styleClass="rdv-booking-sidebar-name" text="Dr. —" wrapText="true"/>
                        <Label styleClass="rdv-booking-sidebar-tag" text="Spécialiste"/>
                    </VBox>
                    <Label fx:id="typeSidebarBio" styleClass="rdv-booking-sidebar-bio" wrapText="true"
                           text="Praticien accompagnant les personnes avec TSA."/>
                    <VBox spacing="6" styleClass="rdv-booking-contact-block">
                        <Label fx:id="typeSidebarPhone" styleClass="rdv-booking-contact-line" text="📞 —"/>
                        <Label fx:id="typeSidebarEmail" styleClass="rdv-booking-contact-line" text="✉ —"/>
                    </VBox>
                </VBox>

                <VBox spacing="8" styleClass="rdv-booking-voice-box">
                    <Label styleClass="rdv-booking-voice-title" text="Assistant vocal (gratuit)"/>
                    <ComboBox fx:id="typeVoiceLang" maxWidth="Infinity" styleClass="rdv-booking-voice-combo"/>
                    <Button mnemonicParsing="false" onAction="#onVoiceAssist" styleClass="rdv-booking-voice-btn"
                            text="🎤 Parler pour prendre RDV"/>
                </VBox>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" minWidth="0" spacing="4" styleClass="rdv-booking-content">
                <Label styleClass="rdv-booking-main-title" text="Type de consultation"/>

                <VBox spacing="5" styleClass="rdv-type-main-card" VBox.vgrow="NEVER">
                    <padding>
                        <Insets bottom="10" left="14" right="14" top="10"/>
                    </padding>

                    <Label styleClass="rdv-type-block-title" text="Type de rendez-vous"/>
                    <VBox fx:id="typeOptionsBox" spacing="5"/>

                    <Label styleClass="rdv-type-block-title" text="Mode de consultation"/>
                    <Label styleClass="rdv-type-mode-value" text="Au cabinet"/>

                    <Label styleClass="rdv-type-block-title" text="Motif de la consultation *"/>
                    <ComboBox fx:id="typeMotifCombo" maxWidth="Infinity" promptText="Sélectionnez un motif"
                              styleClass="rdv-type-motif-combo"/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Button mnemonicParsing="false" onAction="#onRetourCreneau" styleClass="rdv-type-retour"
                                text="&lt; Retour"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
                        <Button mnemonicParsing="false" onAction="#onContinuer" styleClass="rdv-booking-continuer"
                                text="Continuer  →"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
