<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxWidth="960" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.PageRdvController">
    <VBox alignment="TOP_CENTER" maxWidth="960" spacing="16" styleClass="rdv-page rdv-page-clean">
        <VBox maxWidth="Infinity" spacing="8" styleClass="rdv-header-clean">
            <Label styleClass="rdv-page-kicker" text="RÉSERVATION"/>
            <Label styleClass="rdv-page-title-clean" text="Prendre un rendez-vous" textAlignment="LEFT" wrapText="true"/>
            <Label styleClass="rdv-page-sub-clean" text="Uniquement les professionnels disposant d’un compte AutiCare actif. Choisissez un praticien, puis réservez un créneau."
                   textAlignment="LEFT" wrapText="true"/>
        </VBox>

        <VBox maxWidth="Infinity" spacing="0" styleClass="rdv-shell">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="rdv-filters-row">
                <VBox spacing="4" styleClass="rdv-filter-block">
                    <Label styleClass="rdv-filter-cap" text="Spécialité"/>
                    <ComboBox fx:id="rdvSpecialtyFilter" maxWidth="200" promptText="Toutes les spécialités" styleClass="rdv-filter-input"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="rdv-filter-block" maxWidth="Infinity">
                    <Label styleClass="rdv-filter-cap" text="Lieu"/>
                    <TextField fx:id="rdvLieuFilter" promptText="Ville ou adresse…" styleClass="rdv-filter-input" maxWidth="Infinity"/>
                </VBox>
                <Region minWidth="12"/>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="rdv-count-block">
                    <Label fx:id="rdvCountNumLabel" styleClass="rdv-count-num" text="0"/>
                    <Region prefWidth="1" minWidth="1" maxWidth="1" minHeight="32" styleClass="rdv-count-sep"/>
                    <Label styleClass="rdv-count-cap" text="professionnels" wrapText="true" maxWidth="86"/>
                </HBox>
            </HBox>

            <VBox spacing="4" styleClass="rdv-tip">
                <Label styleClass="rdv-tip-title" text="Comment ça marche ?"/>
                <Label styleClass="rdv-tip-text" wrapText="true"
                       text="Choisissez un professionnel, cliquez sur « Prendre RDV », puis sélectionnez date et créneau à l’étape suivante."/>
            </VBox>

            <VBox spacing="10" styleClass="rdv-ai-planner">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="rdv-ai-planner-title" text="✨ Smart Planner IA"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="rdv-ai-planner-badge" text="AutiCare AI"/>
                </HBox>
                <Label styleClass="rdv-ai-planner-sub" wrapText="true"
                       text="Indiquez votre disponibilité : l’IA classe les médecins selon le créneau le plus proche et propose le meilleur plan."/>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="rdv-ai-controls-row">
                    <DatePicker fx:id="rdvAiDatePicker" promptText="Date souhaitée" styleClass="rdv-ai-input"/>
                    <ComboBox fx:id="rdvAiTimeCombo" promptText="Heure souhaitée" prefWidth="140" styleClass="rdv-ai-input"/>
                    <Button text="✨ Générer plan" onAction="#onSuggestByAvailability" styleClass="rdv-ai-generate-btn"/>
                </HBox>
                <Label fx:id="rdvAiStatusLabel" styleClass="rdv-ai-status" wrapText="true"
                       text="Choisissez date/heure, puis cliquez sur Générer plan."/>
                <VBox fx:id="rdvAiSuggestionsBox" spacing="12" styleClass="rdv-ai-suggestions-wrap"/>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minViewportHeight="0" prefViewportHeight="420" styleClass="rdv-scroll-clean" vbarPolicy="AS_NEEDED">
                <VBox fx:id="rdvDoctorsList" spacing="20" styleClass="rdv-stack"/>
            </ScrollPane>
        </VBox>
    </VBox>

    <VBox fx:id="rdvChatbotPanel" managed="false" visible="false" spacing="10"
          styleClass="rdv-chatbot-panel" StackPane.alignment="BOTTOM_RIGHT"
          prefWidth="430" maxWidth="430" prefHeight="560" maxHeight="560">
        <HBox alignment="CENTER_LEFT" styleClass="rdv-chatbot-header">
            <Label styleClass="rdv-chatbot-title" text="Assistant AutiCare"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="rdvChatbotExpandBtn" text="⤢" styleClass="rdv-chatbot-icon-btn"
                    onAction="#onToggleRdvChatbotSize"/>
            <Button text="🗑" styleClass="rdv-chatbot-icon-btn" onAction="#onClearRdvChatbotHistory"/>
            <Button text="×" styleClass="rdv-chatbot-icon-btn" onAction="#onToggleRdvChatbot"/>
        </HBox>
        <VBox spacing="4" styleClass="rdv-chatbot-intro-card">
            <Label styleClass="rdv-chatbot-intro-title" text="Bonjour, je suis l'assistant AutiCare." wrapText="true"/>
            <Label styleClass="rdv-chatbot-subtitle" text="" wrapText="true" managed="false" visible="false"/>
            <Label styleClass="rdv-chatbot-intro-caption" text="Choisissez un thème ou écrivez librement :" wrapText="true"/>
            <HBox spacing="6" styleClass="rdv-chatbot-chip-wrap">
                <Button fx:id="rdvQuizQuestionnaireBtn" text="Quiz texte" styleClass="rdv-chatbot-chip rdv-chip-green"
                        onAction="#onStartAutismQuestionnaireQuiz"/>
                <Button fx:id="rdvQuizImagesBtn" text="Quiz Rorschach" styleClass="rdv-chatbot-chip rdv-chip-blue"
                        onAction="#onStartRorschachImageQuiz"/>
                <Button text="Émotions" styleClass="rdv-chatbot-chip" onAction="#onQuickThemeEmotions"/>
                <Button text="Sensoriel" styleClass="rdv-chatbot-chip" onAction="#onQuickThemeSensoriel"/>
            </HBox>
            <HBox spacing="6" styleClass="rdv-chatbot-chip-wrap">
                <Button text="Routine" styleClass="rdv-chatbot-chip" onAction="#onQuickThemeRoutine"/>
                <Button text="Calme" styleClass="rdv-chatbot-chip" onAction="#onQuickThemeCalme"/>
            </HBox>
        </VBox>
        <ImageView fx:id="rdvChatbotImageView" fitHeight="120" fitWidth="220" preserveRatio="true"
                   managed="false" visible="false" styleClass="rdv-chatbot-image"/>
        <Label fx:id="rdvChatbotImageCaption" styleClass="rdv-chatbot-image-caption" wrapText="true"/>
        <ScrollPane fx:id="rdvChatbotHistoryScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="rdv-chatbot-history" VBox.vgrow="ALWAYS">
            <VBox fx:id="rdvChatbotHistory" spacing="8" styleClass="rdv-chatbot-history-box"/>
        </ScrollPane>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="rdv-chatbot-quick-row">
            <Label styleClass="rdv-chatbot-quick-label" text="Rapide :"/>
            <Button text="Quiz texte" styleClass="rdv-chatbot-mini-chip rdv-chip-green" onAction="#onStartAutismQuestionnaireQuiz"/>
            <Button text="Quiz Rorschach" styleClass="rdv-chatbot-mini-chip rdv-chip-blue" onAction="#onStartRorschachImageQuiz"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="rdv-chatbot-input-row">
            <Button text="🖼" styleClass="rdv-chatbot-media-btn" onAction="#onMediaActionInfo"/>
            <TextField fx:id="rdvChatbotInput" promptText="Parlez ou écrivez..."
                       HBox.hgrow="ALWAYS" styleClass="rdv-chatbot-input"
                       onAction="#onSendRdvChatbotMessage"/>
            <Button text="🎤" styleClass="rdv-chatbot-media-btn" onAction="#onMediaActionInfo"/>
            <Button text="Envoyer" styleClass="rdv-chatbot-send-btn" onAction="#onSendRdvChatbotMessage"/>
        </HBox>
    </VBox>

    <Button text="💬  Besoin d'aide ?" styleClass="rdv-chatbot-toggle-btn"
            onAction="#onToggleRdvChatbot" StackPane.alignment="BOTTOM_RIGHT"/>
</StackPane>
