<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxWidth="720" spacing="14" styleClass="public-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.PageDemandeProduitController">
    <padding><Insets bottom="24" left="16" right="16" top="16"/></padding>
    <Label styleClass="public-page-kicker" text="CATALOGUE" />
    <Label styleClass="public-page-title" text="Demander un produit" textAlignment="CENTER" wrapText="true" />
    <Label styleClass="public-page-lead" text="Décrivez le matériel souhaité. Une proposition de fiche sera transmise à l’équipe pour validation." textAlignment="CENTER" wrapText="true" />

    <VBox fx:id="assistantBox" alignment="TOP_LEFT" spacing="0" styleClass="public-page-card" />

    <VBox alignment="TOP_LEFT" spacing="10" styleClass="public-page-card">
        <Label text="Votre demande *" />
        <TextArea fx:id="demandeArea" prefRowCount="5" wrapText="true" />
        <Label text="Budget (DT, optionnel)" />
        <TextField fx:id="budgetField" promptText="ex. 120" />
        <Label text="Catégorie suggérée" />
        <ComboBox fx:id="categorieCombo" prefWidth="320" />
        <Button fx:id="submitBtn" mnemonicParsing="false" styleClass="catalog-add-cart-btn" text="Envoyer la demande" />
    </VBox>
</VBox>
