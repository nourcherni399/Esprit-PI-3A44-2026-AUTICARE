<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxWidth="920" spacing="14" styleClass="public-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="public-page-kicker" text="RESSOURCES" />
    <Label styleClass="public-page-title" text="Blog" textAlignment="CENTER" wrapText="true" />
    <Label styleClass="public-page-lead" text="Articles, témoignages et conseils pour les familles et les professionnels : un espace pour partager et s’informer." textAlignment="CENTER" wrapText="true" />
    <VBox alignment="TOP_CENTER" styleClass="public-page-card">
        <Label styleClass="public-page-body" text="Les billets de blog seront affichés ici (liste ou grille). Vous pourrez brancher une source de contenu ou un éditeur depuis le tableau de bord." textAlignment="CENTER" wrapText="true" />
    </VBox>
</VBox>
