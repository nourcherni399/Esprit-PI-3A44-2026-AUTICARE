<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="14" styleClass="public-page events-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.PageNotificationsController">
    <VBox spacing="3" styleClass="events-header">
        <Label styleClass="events-page-title" text="Mes notifications"/>
        <Label styleClass="events-page-subtitle" text="Retrouvez ici les réponses de l'équipe et le statut de vos inscriptions aux événements."/>
    </VBox>

    <VBox maxWidth="Infinity" spacing="14" styleClass="public-white-sheet">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="380" styleClass="events-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="notificationsListBox" maxWidth="Infinity" spacing="10"/>
            </content>
        </ScrollPane>
        <Label fx:id="notificationsEmptyLabel" managed="false" styleClass="events-other-empty" text="Aucune notification." visible="false"/>
    </VBox>
</VBox>
