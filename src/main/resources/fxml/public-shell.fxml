<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="home-root" stylesheets="@../styles/login.css,@../styles/home.css,@../styles/public-page.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.PublicShellController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-nav nav-home">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="nav-brand-block">
                <ImageView fitHeight="70" pickOnBounds="true" preserveRatio="true" styleClass="nav-brand-logo-img">
                    <image>
                        <Image url="@../images/brand/auticare-logo-auth.png" />
                    </image>
                </ImageView>
                <Region styleClass="nav-vsep" />
            </HBox>
            <Region maxWidth="Infinity" minWidth="8" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="4" styleClass="nav-center-links">
                <HBox fx:id="shellNavAccueil" alignment="CENTER_LEFT" onMouseClicked="#onNavAccueil" spacing="10" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="♡" />
                    <Label styleClass="nav-item-label" text="Accueil" />
                </HBox>
                <HBox fx:id="shellNavProduits" alignment="CENTER_LEFT" onMouseClicked="#onNavProduits" spacing="10" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="🛒" />
                    <Label styleClass="nav-item-label" text="Produits" />
                </HBox>
                <HBox fx:id="shellNavRdv" alignment="CENTER_LEFT" onMouseClicked="#onNavRdv" spacing="10" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="🕐" />
                    <Label styleClass="nav-item-label" text="Rendez-vous" />
                </HBox>
                <HBox fx:id="shellNavEvents" alignment="CENTER_LEFT" onMouseClicked="#onNavEvents" spacing="10" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="📅" />
                    <Label styleClass="nav-item-label" text="Événements" />
                </HBox>
                <HBox fx:id="shellNavBlog" alignment="CENTER_LEFT" onMouseClicked="#onNavBlog" spacing="10" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="📖" />
                    <Label styleClass="nav-item-label" text="Blog" />
                </HBox>
            </HBox>
            <Region maxWidth="Infinity" minWidth="8" HBox.hgrow="ALWAYS" />
            <Region styleClass="nav-vsep" />
            <HBox alignment="CENTER_RIGHT" spacing="18" styleClass="nav-trailing">
                <StackPane fx:id="patientNotifBellHost" alignment="CENTER" managed="false" minHeight="40" minWidth="40" onMouseClicked="#onPatientNotifBell" styleClass="nav-patient-bell-host" visible="false">
                    <Label styleClass="nav-patient-bell-icon" text="🔔" />
                    <Label fx:id="patientNotifBadge" alignment="CENTER" managed="false" styleClass="nav-patient-bell-badge" text="0" visible="false" StackPane.alignment="TOP_RIGHT" />
                </StackPane>
                <Button focusTraversable="false" onAction="#onToggleTheme" styleClass="icon-btn" text="🌙" />
                <HBox fx:id="guestNavActions" alignment="CENTER_RIGHT" spacing="16">
                    <Hyperlink fx:id="shellConnexionLink" onAction="#onNavConnexion" styleClass="nav-link" text="Connexion" />
                    <Button fx:id="shellSignupBtn" contentDisplay="LEFT" graphicTextGap="10" onAction="#onRegister" styleClass="signup-btn" text="S'inscrire">
                        <graphic>
                            <Label styleClass="signup-btn-icon" text="👤" />
                        </graphic>
                    </Button>
                </HBox>
                <HBox fx:id="loggedNavActions" alignment="CENTER_RIGHT" managed="false" onMouseClicked="#onOpenMyProfile" spacing="8" styleClass="home-topbar-profile" visible="false">
                    <StackPane fx:id="loggedAvatarHost" minHeight="42" minWidth="42" prefHeight="42" prefWidth="42" />
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <HBox alignment="CENTER_LEFT" spacing="4">
                            <Label fx:id="loggedUserNameLabel" styleClass="home-topbar-name" text="Utilisateur" />
                            <Label fx:id="loggedUserCodeLabel" styleClass="home-topbar-code" text="0000" />
                        </HBox>
                        <Hyperlink onAction="#onLogout" onMouseClicked="#onLogoutLinkClick" styleClass="home-topbar-logout" text="Se déconnecter" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="4" styleClass="nav-lang-row">
                    <Label styleClass="nav-icon-symbol" text="🌐" />
                    <ComboBox fx:id="langCombo" prefWidth="56" styleClass="lang-combo" />
                    <Label styleClass="nav-lang-chevron" text="▾" />
                </HBox>
            </HBox>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="home-page-stack">
            <StackPane maxHeight="Infinity" maxWidth="Infinity" styleClass="home-global-bg-clip">
                <ImageView fx:id="globalBgA" preserveRatio="false" styleClass="home-global-bg-img" />
                <ImageView fx:id="globalBgB" preserveRatio="false" styleClass="home-global-bg-img" />
                <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="home-global-veil" />
            </StackPane>
            <StackPane fx:id="shellHeroLayer" maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" pickOnBounds="false" styleClass="home-fixed-hero-layer">
                <HBox maxHeight="Infinity" maxWidth="Infinity" styleClass="home-hero-bg">
                    <StackPane maxHeight="Infinity" maxWidth="Infinity" styleClass="home-hero-photo-wrap" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="heroBgImageA" preserveRatio="false" styleClass="home-hero-bg-img" />
                        <ImageView fx:id="heroBgImageB" preserveRatio="false" styleClass="home-hero-bg-img" />
                        <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="home-hero-left-fallback" />
                        <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-hero-left-toning" />
                    </StackPane>
                </HBox>
                <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-hero-vignette" />
                <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-fullpage-scrim" />
            </StackPane>
            <ScrollPane fx:id="shellScrollPane" fitToWidth="true" hbarPolicy="NEVER" maxHeight="Infinity" styleClass="home-scroll" vbarPolicy="AS_NEEDED">
                <VBox maxWidth="Infinity" spacing="0" styleClass="home-scroll-content">
                    <StackPane fx:id="shellHeroScrollSpacer" maxWidth="Infinity" minHeight="320" styleClass="home-hero-content-layer" />
                    <StackPane fx:id="pageContentHost" maxWidth="Infinity" styleClass="public-shell-page-host" />
                    <VBox alignment="CENTER" focusTraversable="false" spacing="10" styleClass="public-shell-mini-footer">
                        <HBox alignment="CENTER" focusTraversable="false" spacing="6" styleClass="public-shell-footer-links">
                            <Hyperlink focusTraversable="false" onAction="#onShellFooterAccueil" styleClass="home-footer-link-mini" text="Accueil" />
                            <Label styleClass="home-footer-link-sep" text="·" />
                            <Hyperlink focusTraversable="false" onAction="#onShellFooterProduits" styleClass="home-footer-link-mini" text="Produits" />
                            <Label styleClass="home-footer-link-sep" text="·" />
                            <Hyperlink focusTraversable="false" onAction="#onShellFooterRdv" styleClass="home-footer-link-mini" text="Rendez-vous" />
                            <Label styleClass="home-footer-link-sep" text="·" />
                            <Hyperlink focusTraversable="false" onAction="#onShellFooterEvents" styleClass="home-footer-link-mini" text="Événements" />
                            <Label styleClass="home-footer-link-sep" text="·" />
                            <Hyperlink focusTraversable="false" onAction="#onShellFooterBlog" styleClass="home-footer-link-mini" text="Blog" />
                        </HBox>
                        <Label alignment="CENTER" maxWidth="Infinity" styleClass="home-footer-copy-stats" text="© 2026 AutiCare — Écouter · Aider · Accompagner" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="home-news-ticker">
            <HBox alignment="CENTER" styleClass="home-news-ticker-brand">
                <Label styleClass="home-news-ticker-brand-text" text="Actualités" />
            </HBox>
            <StackPane fx:id="newsTickerViewport" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="home-news-ticker-viewport" />
        </HBox>
    </bottom>
</BorderPane>
