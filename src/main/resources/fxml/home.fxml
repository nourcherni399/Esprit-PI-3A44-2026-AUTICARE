<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="home-root" stylesheets="@../styles/login.css,@../styles/home.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.HomeController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-nav">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="nav-brand-block">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <ImageView fitHeight="30" fitWidth="30" pickOnBounds="true" preserveRatio="true" styleClass="nav-logo-image">
                        <image>
                            <Image url="https://upload.wikimedia.org/wikipedia/commons/thumb/0/06/Autism_awareness_ribbon.svg/240px-Autism_awareness_ribbon.svg.png" />
                        </image>
                    </ImageView>
                </HBox>
                <Region styleClass="nav-vsep" />
            </HBox>
            <Region maxWidth="Infinity" minWidth="8" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="6" styleClass="nav-center-links">
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavAccueil" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="♥" />
                    <Label styleClass="nav-item-label" text="Accueil" />
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavProduits" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="🛒" />
                    <Label styleClass="nav-item-label" text="Produits" />
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavRdv" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="🕐" />
                    <Label styleClass="nav-item-label" text="Rendez-vous" />
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavEvents" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="📅" />
                    <Label styleClass="nav-item-label" text="Événements" />
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavBlog" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="📖" />
                    <Label styleClass="nav-item-label" text="Blog" />
                </HBox>
            </HBox>
            <Region maxWidth="Infinity" minWidth="8" HBox.hgrow="ALWAYS" />
            <Region styleClass="nav-vsep" />
            <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="nav-trailing">
                <Button focusTraversable="false" onAction="#onToggleTheme" styleClass="icon-btn" text="🌙" />
                <HBox fx:id="guestNavActions" alignment="CENTER_RIGHT" spacing="14">
                    <Hyperlink onAction="#onNavConnexion" styleClass="nav-link" text="Connexion" />
                    <Button contentDisplay="LEFT" graphicTextGap="10" onAction="#onRegister" styleClass="signup-btn" text="S'inscrire">
                        <graphic>
                            <Label styleClass="signup-btn-icon" text="👤" />
                        </graphic>
                    </Button>
                </HBox>
                <HBox fx:id="loggedNavActions" alignment="CENTER_RIGHT" managed="false" onMouseClicked="#onOpenMyProfile" spacing="8" styleClass="home-topbar-profile" visible="false">
                    <StackPane fx:id="loggedAvatarHost" minHeight="42" minWidth="42" prefHeight="42" prefWidth="42" />
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <HBox alignment="CENTER_LEFT" spacing="4">
                            <Label fx:id="loggedUserNameLabel" styleClass="home-topbar-name" text="Utilisateur" />
                            <Label fx:id="loggedUserCodeLabel" styleClass="home-topbar-code" text="0000" />
                        </HBox>
                        <Hyperlink onAction="#onLogout" onMouseClicked="#onLogoutLinkClick" styleClass="home-topbar-logout" text="Se déconnecter" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6" styleClass="nav-lang-row">
                    <Label styleClass="nav-icon-symbol" text="🌐" />
                    <ComboBox fx:id="langCombo" prefWidth="72" styleClass="lang-combo" />
                </HBox>
            </HBox>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="home-page-stack">
            <StackPane maxHeight="Infinity" maxWidth="Infinity" styleClass="home-global-bg-clip">
                <ImageView fx:id="globalBgA" preserveRatio="false" styleClass="home-global-bg-img" />
                <ImageView fx:id="globalBgB" preserveRatio="false" styleClass="home-global-bg-img" />
                <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="home-global-veil" />
            </StackPane>
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" maxHeight="Infinity" styleClass="home-scroll" vbarPolicy="AS_NEEDED">
            <VBox fx:id="scrollContent" styleClass="home-scroll-content">
                <!-- Hero : photo + volet lavande + diaporama (état avant focus design) -->
                <StackPane styleClass="home-hero">
                    <HBox maxWidth="Infinity" styleClass="home-hero-bg">
                        <StackPane minHeight="440" styleClass="home-hero-photo-wrap" HBox.hgrow="ALWAYS">
                            <ImageView fx:id="heroBgImageA" preserveRatio="false" styleClass="home-hero-bg-img" />
                            <ImageView fx:id="heroBgImageB" preserveRatio="false" styleClass="home-hero-bg-img" />
                            <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="home-hero-left-fallback" />
                            <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-hero-left-toning" />
                        </StackPane>
                        <Region minWidth="260" prefWidth="340" styleClass="home-hero-right" HBox.hgrow="SOMETIMES" />
                    </HBox>
                    <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-hero-vignette" />
                    <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-hero-bottom-fade" />
                    <VBox alignment="CENTER" maxWidth="920" prefHeight="442.0" prefWidth="920.0" styleClass="home-hero-center">
                        <HBox alignment="CENTER" styleClass="home-hero-badge-row">
                            <Label styleClass="home-hero-badge-icon" text="✦" />
                            <Label styleClass="home-hero-badge" text="Bienvenue sur AutiCare" />
                        </HBox>
                        <Label styleClass="home-hero-title" text="Accompagnement bienveillant pour les personnes autistes" textAlignment="CENTER" wrapText="true" />
                        <Label styleClass="home-hero-sub" text="Une plateforme dédiée aux personnes autistes et à leurs familles. Produits adaptés, événements et une communauté à vos côtés." textAlignment="CENTER" wrapText="true" />
                        <HBox alignment="CENTER" styleClass="home-hero-actions">
                        <Button minHeight="46" minWidth="220" onAction="#onJoinSignup" prefHeight="46" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-background-color: #a5bfa1; -fx-text-fill: white; -fx-background-radius: 14;" styleClass="home-btn-cta-sage home-btn-soft home-cta-lift" text="Découvrir nos produits →" />
                        <Button minHeight="46" minWidth="220" onAction="#onJoinSignup" prefHeight="46" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-background-color: #a5bfa1; -fx-text-fill: white; -fx-background-radius: 14;" styleClass="home-btn-cta-sage home-btn-soft home-cta-lift" text="Voir les événements" />
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- Mission : fond animé + contenu -->
                <StackPane maxWidth="Infinity" styleClass="home-mission-outer">
                    <StackPane maxHeight="Infinity" maxWidth="Infinity" minHeight="420" styleClass="home-mission-photo-host">
                        <ImageView fx:id="missionBgA" preserveRatio="false" styleClass="home-mission-bg-img" />
                        <ImageView fx:id="missionBgB" preserveRatio="false" styleClass="home-mission-bg-img" />
                        <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="home-mission-bg-veil" />
                    </StackPane>
                    <VBox fx:id="sectionAnchorMission" styleClass="home-mission-section">
                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="home-mission-grid">
                            <StackPane maxHeight="400" styleClass="home-mission-img-wrap" HBox.hgrow="ALWAYS">
                                <ImageView fitWidth="560" preserveRatio="true" styleClass="home-mission-img">
                                    <image>
                                        <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1607619056574-7b8d3ee536b2?w=1200&amp;q=90" />
                                    </image>
                                </ImageView>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="12" styleClass="home-mission-text" HBox.hgrow="ALWAYS">
                                <Label styleClass="home-mission-tag" text="NOTRE MISSION" />
                                <Label styleClass="home-mission-title" text="Écouter, aider, accompagner" wrapText="true" />
                                <Label styleClass="home-mission-body" text="AutiCare propose un accompagnement adapté aux personnes autistes et à leurs proches : produits spécialisés, ateliers, événements et un espace d'échange bienveillant." wrapText="true" />
                           <Button minHeight="46" minWidth="220" onAction="#onJoinSignup" prefHeight="46" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-background-color: #a5bfa1; -fx-text-fill: white; -fx-background-radius: 14;" styleClass="home-btn-cta-sage home-btn-soft home-cta-lift" text="En savoir plus →" />
                            </VBox>
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- Statistiques -->
                <VBox styleClass="home-stats-only-wrap">
                    <HBox maxWidth="Infinity" styleClass="home-stats-row">
                        <VBox alignment="CENTER" styleClass="home-stat-card home-stat-mint home-stat-bordered home-hover-lift">
                            <Label styleClass="home-stat-num" text="500+" />
                            <Label styleClass="home-stat-label" text="Familles accompagnées" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                        <VBox alignment="CENTER" styleClass="home-stat-card home-stat-blue home-stat-bordered home-hover-lift">
                            <Label prefHeight="49.0" prefWidth="76.0" styleClass="home-stat-num" text="50+" />
                            <Label styleClass="home-stat-label" text="Événements par an" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                        <VBox alignment="CENTER" styleClass="home-stat-card home-stat-peach home-stat-bordered home-hover-lift">
                            <Label styleClass="home-stat-num" text="100+" />
                            <Label styleClass="home-stat-label" text="Produits adaptés" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Produits IA (rempli en Java si produits publiés) -->
                <VBox fx:id="aiProductsSection" managed="false" styleClass="home-ai-section" visible="false">
                    <VBox alignment="CENTER" spacing="8" styleClass="home-ai-header">
                        <Label styleClass="home-ai-badge" text="Nouveauté" />
                        <Label styleClass="home-ai-title" text="Produits suggérés par l'IA" />
                        <Label styleClass="home-ai-sub" text="Des produits créés grâce à notre assistant et validés pour vous." textAlignment="CENTER" wrapText="true" />
                    </VBox>
                    <FlowPane fx:id="aiProductsFlow" alignment="CENTER" hgap="20" maxWidth="960" prefWrapLength="880" styleClass="home-ai-flow" vgap="20" />
                    <HBox alignment="CENTER" styleClass="home-ai-footer">
                        <Button onAction="#onAiSeeAllProducts" styleClass="home-ai-see-all home-btn-soft home-cta-lift" text="Voir tous les produits →" />
                    </HBox>
                </VBox>

                <!-- Bandeau « Tout ce dont vous avez besoin » (photo + voile, texte centré) -->
                <StackPane maxWidth="Infinity" styleClass="home-need-stack">
                    <Region fx:id="needBgA" maxHeight="Infinity" maxWidth="Infinity" styleClass="home-need-bg home-need-bg-a" />
                    <Region fx:id="needBgB" maxHeight="Infinity" maxWidth="Infinity" styleClass="home-need-bg home-need-bg-b" />
                    <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-need-overlay" />
                    <VBox alignment="CENTER" styleClass="home-need-content">
                        <Label styleClass="home-need-title" text="Tout ce dont vous avez besoin" />
                        <Label styleClass="home-need-sub" text="AutiCare propose un ensemble complet de services pour accompagner les personnes autistes et leurs proches au quotidien." textAlignment="CENTER" wrapText="true" />
                    </VBox>
                </StackPane>

                <!-- 4 cartes services + images Unsplash -->
                <VBox styleClass="home-features-wrap">
                    <HBox alignment="TOP_CENTER" maxWidth="Infinity" styleClass="home-features-row">
                        <VBox fx:id="sectionAnchorProduits" styleClass="home-feature-card home-feature-border-green home-hover-lift">
                            <StackPane maxHeight="144" minHeight="144" prefHeight="144" styleClass="home-feature-img-frame">
                                <ImageView fitHeight="144" fitWidth="260" preserveRatio="false" styleClass="home-feature-photo">
                                    <image>
                                        <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1616486338811-3dada111a655?w=800&amp;q=90" />
                                    </image>
                                </ImageView>
                           <ImageView fitHeight="144" fitWidth="260" preserveRatio="false" styleClass="home-feature-photo">
                              <image>
                                 <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=800&amp;q=90" />
                              </image>
                           </ImageView>
                            </StackPane>
                            <VBox styleClass="home-feature-body">
                                <Label styleClass="home-feature-title" text="Produits spécialisés" />
                                <Label styleClass="home-feature-desc" text="Stimulation sensorielle, concentration et apaisement au quotidien." wrapText="true" />
                                <Hyperlink onAction="#onFeatureProducts" styleClass="home-feature-link home-feature-link-green" text="Découvrir →" />
                            </VBox>
                        </VBox>
                        <VBox fx:id="sectionAnchorEvents" styleClass="home-feature-card home-feature-border-lavender home-hover-lift">
                            <StackPane maxHeight="144" minHeight="144" prefHeight="144" styleClass="home-feature-img-frame">
                                <ImageView fitHeight="144" fitWidth="260" preserveRatio="false" styleClass="home-feature-photo">
                                    <image>
                                        <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&amp;q=90" />
                                    </image>
                                </ImageView>
                            </StackPane>
                            <VBox styleClass="home-feature-body">
                                <Label styleClass="home-feature-title" text="Événements &amp; ateliers" />
                                <Label styleClass="home-feature-desc" text="Ateliers, rencontres et sensibilisation adaptés à vos besoins." wrapText="true" />
                                <Hyperlink onAction="#onFeatureEvents" styleClass="home-feature-link home-feature-link-lavender" text="Voir le programme →" />
                            </VBox>
                        </VBox>
                        <VBox fx:id="sectionAnchorBlog" styleClass="home-feature-card home-feature-border-sky home-hover-lift">
                            <StackPane maxHeight="144" minHeight="144" prefHeight="144" styleClass="home-feature-img-frame">
                                <ImageView fitHeight="144" fitWidth="260" preserveRatio="false" styleClass="home-feature-photo">
                                    <image>
                                        <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=800&amp;q=90" />
                                    </image>
                                </ImageView>
                            </StackPane>
                            <VBox styleClass="home-feature-body">
                                <Label styleClass="home-feature-title" text="Blog &amp; ressources" />
                                <Label styleClass="home-feature-desc" text="Expériences, conseils et articles pour les familles." wrapText="true" />
                                <Hyperlink onAction="#onFeatureBlog" styleClass="home-feature-link home-feature-link-sky" text="Lire le blog →" />
                            </VBox>
                        </VBox>
                        <VBox styleClass="home-feature-card home-feature-border-coral home-hover-lift">
                            <StackPane maxHeight="144" minHeight="144" prefHeight="144" styleClass="home-feature-img-frame">
                                <ImageView fitHeight="144" fitWidth="260" preserveRatio="false" styleClass="home-feature-photo">
                                    <image>
                                        <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=800&amp;q=90" />
                                    </image>
                                </ImageView>
                            </StackPane>
                            <VBox styleClass="home-feature-body">
                                <Label styleClass="home-feature-title" text="Communauté bienveillante" />
                                <Label styleClass="home-feature-desc" text="Un espace d'échange où chacun est accueilli avec respect." wrapText="true" />
                                <Hyperlink onAction="#onFeatureCommunity" styleClass="home-feature-link home-feature-link-coral-strong" text="Rejoindre →" />
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Témoignages (bloc rose + bande image droite) -->
                <StackPane maxWidth="Infinity" styleClass="home-testi-stack">
                    <HBox maxHeight="Infinity" maxWidth="Infinity">
                        <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="home-testi-left-panel" HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="home-testi-photo-host">
                            <ImageView fx:id="testiBgA" preserveRatio="false" styleClass="home-testi-bg-img" />
                            <ImageView fx:id="testiBgB" preserveRatio="false" styleClass="home-testi-bg-img" />
                            <Region maxHeight="Infinity" maxWidth="Infinity" mouseTransparent="true" styleClass="home-testi-overlay" />
                        </StackPane>
                    </HBox>
                    <VBox styleClass="home-testi-wrap">
                        <Label styleClass="home-testi-title" text="Ce que dit notre communauté" />
                        <Label styleClass="home-testi-sub" text="Des familles et des personnes qui nous font confiance." />
                        <HBox maxWidth="Infinity" styleClass="home-testi-row">
                            <VBox styleClass="home-testi-card home-testi-border-lavender home-hover-lift">
                                <Label styleClass="home-testi-quote home-testi-quote-lavender" text="&quot;" />
                                <Label prefHeight="50.0" prefWidth="594.0" styleClass="home-testi-text" text="AutiCare nous a accompagnés avec une bienveillance rare. Les produits recommandés ont vraiment aidé notre fils au quotidien." textAlignment="CENTER" wrapText="true" />
                                <HBox alignment="CENTER_LEFT" prefHeight="48.0" prefWidth="898.0" spacing="12">
                                    <ImageView fitHeight="48" fitWidth="48" preserveRatio="true" styleClass="home-testi-avatar-img">
                                        <image>
                                            <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=160&amp;h=160&amp;fit=crop&amp;q=90" />
                                        </image>
                                    </ImageView>
                                    <VBox spacing="2">
                                        <Label styleClass="home-testi-name" text="Marie L." />
                                        <Label styleClass="home-testi-role" text="Maman d'un enfant autiste" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox styleClass="home-testi-card home-testi-border-mint home-hover-lift">
                                <Label styleClass="home-testi-quote home-testi-quote-mint" text="&quot;" />
                                <Label prefHeight="50.0" prefWidth="580.0" styleClass="home-testi-text" text="Enfin une plateforme qui me comprend. Les événements en ligne m'ont permis de rencontrer d'autres personnes comme moi." textAlignment="CENTER" wrapText="true" />
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <ImageView fitHeight="48" fitWidth="48" preserveRatio="true" styleClass="home-testi-avatar-img">
                                        <image>
                                            <Image backgroundLoading="true" url="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=160&amp;h=160&amp;fit=crop&amp;q=90" />
                                        </image>
                                    </ImageView>
                                    <VBox spacing="2">
                                        <Label styleClass="home-testi-name" text="Thomas D." />
                                        <Label styleClass="home-testi-role" text="Personne autiste" textAlignment="CENTER" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox styleClass="home-testi-card home-testi-border-sky home-hover-lift">
                                <Label styleClass="home-testi-quote home-testi-quote-sky" text="&quot;" />
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <VBox spacing="2" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- CTA final : invité vs connecté -->
                <StackPane maxWidth="Infinity" styleClass="home-join-outer">
                    <Region fx:id="joinBgA" maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: linear-gradient(to right, #edf6ea 0%, #f5f0fa 100%);" styleClass="home-join-bg-layer home-join-bg-a" />
                    <Region fx:id="joinBgB" maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: linear-gradient(to right, #e9f3e6 0%, #faf6fc 100%);" styleClass="home-join-bg-layer home-join-bg-b" />
                    <VBox fx:id="sectionAnchorCommunity" styleClass="home-join">
                        <ImageView fitHeight="96" fitWidth="96" preserveRatio="true" styleClass="home-join-logo">
                            <image>
                                <Image url="https://upload.wikimedia.org/wikipedia/commons/thumb/0/06/Autism_awareness_ribbon.svg/240px-Autism_awareness_ribbon.svg.png" />
                            </image>
                        </ImageView>
                        <VBox fx:id="ctaGuest" spacing="14" styleClass="home-cta-block">
                            <Label prefHeight="75.0" prefWidth="773.0" style="-fx-font-size: 50px; -fx-font-weight: 800; -fx-text-fill: #2d2d2d;" styleClass="home-join-title" text="Rejoignez notre communauté" />
                            <Label style="-fx-font-size: 17px; -fx-text-fill: #666666; -fx-font-weight: 500;" styleClass="home-join-sub" text="Créez votre compte et accédez aux produits adaptés, événements et à un espace d'échange bienveillant." textAlignment="CENTER" wrapText="true" />
                            <HBox styleClass="home-join-actions">
                                <Button minHeight="46" minWidth="220" onAction="#onJoinSignup" prefHeight="46" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-background-color: #a5bfa1; -fx-text-fill: white; -fx-background-radius: 14;" styleClass="home-btn-cta-sage home-btn-soft home-cta-lift" text="Créer mon compte  →" />
                                <Button minHeight="46" minWidth="170" onAction="#onJoinLogin" prefHeight="46" prefWidth="170" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-background-color: white; -fx-text-fill: #2d2d2d; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-width: 1; -fx-border-color: rgba(0,0,0,0.12);" styleClass="home-btn-secondary home-btn-soft home-cta-lift" text="Se connecter" />
                                <Button minHeight="46" minWidth="170" onAction="#onJoinContact" prefHeight="46" prefWidth="170" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-background-color: white; -fx-text-fill: #2d2d2d; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-width: 1; -fx-border-color: rgba(0,0,0,0.12);" styleClass="home-btn-secondary home-btn-soft home-cta-lift" text="Nous contacter" />
                            </HBox>
                        </VBox>
                        <VBox fx:id="ctaLoggedIn" managed="false" spacing="14" styleClass="home-cta-block" visible="false">
                            <Label styleClass="home-join-title" text="Vous faites partie de la communauté" />
                            <Label styleClass="home-join-sub" text="Accédez à vos services : produits, événements et votre espace personnel." textAlignment="CENTER" wrapText="true" />
                            <HBox styleClass="home-join-actions">
