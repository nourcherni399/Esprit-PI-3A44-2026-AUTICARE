<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="dialogRoot"
            prefWidth="560" prefHeight="500"
            styleClass="spell-dialog-root"
            stylesheets="@../styles/spell-check-dialog.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.SpellCheckDialogController">

    <!-- TOP: header always fixed -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="spell-dialog-header">
            <Label text="Vérification orthographique" styleClass="spell-dialog-title"/>
        </HBox>
    </top>

    <!-- CENTER: grows automatically to fill all available space -->
    <center>
        <VBox fx:id="dialogCenter" spacing="12" styleClass="spell-dialog-center">

            <!-- Loading / error status -->
            <Label fx:id="statusLabel" text="" styleClass="spell-dialog-status"
                   wrapText="true" managed="false" visible="false"/>

            <!-- Corrections section -->
            <VBox fx:id="correctionsSection" spacing="8" VBox.vgrow="ALWAYS"
                  managed="false" visible="false">
                <Label text="Corrections proposées :" styleClass="spell-dialog-section-title"/>
                <ScrollPane fx:id="scrollPane" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="spell-dialog-scroll"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="correctionsContainer" spacing="10"
                          styleClass="spell-dialog-corrections-list"/>
                </ScrollPane>
            </VBox>

            <!-- No errors -->
            <Label fx:id="noErrorsLabel" text="✅ Aucune faute détectée !"
                   styleClass="spell-dialog-no-errors"
                   managed="false" visible="false" wrapText="true"/>
        </VBox>
    </center>

    <!-- BOTTOM: apply button — always pinned at the bottom -->
    <bottom>
        <VBox styleClass="spell-dialog-bottom">
            <Button fx:id="applyBtn" text="Appliquer et modifier l'article"
                    onAction="#onApply"
                    styleClass="spell-dialog-apply-btn" maxWidth="Infinity"
                    managed="false" visible="false"/>
        </VBox>
    </bottom>

</BorderPane>
