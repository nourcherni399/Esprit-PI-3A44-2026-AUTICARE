<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="categoryDetailView" alignment="TOP_CENTER" spacing="0" maxWidth="Infinity" prefWidth="1200" prefHeight="700"
      visible="false" managed="false"
      stylesheets="@../../styles/page-blog.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER_LEFT" maxWidth="1060" styleClass="blog-detail-topbar">
        <Button fx:id="backToCategoriesBtn" onAction="#onBackToCategories" styleClass="blog-back-btn" text="← Retour aux catégories"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" maxWidth="1060" spacing="20" styleClass="blog-detail-header">
        <StackPane styleClass="blog-detail-header-img-wrap">
            <ImageView fx:id="detailHeaderImg" fitWidth="120" fitHeight="120" pickOnBounds="true" preserveRatio="true"/>
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
            <Label fx:id="detailCatTitle" styleClass="blog-detail-cat-title" text="Catégorie" wrapText="true"/>
            <Label fx:id="detailCatDesc" styleClass="blog-detail-cat-desc" wrapText="true"/>
        </VBox>
    </HBox>

    <FlowPane fx:id="moduleCardsPane" hgap="20" vgap="20" maxWidth="1060" styleClass="blog-modules-flow"/>
</VBox>
