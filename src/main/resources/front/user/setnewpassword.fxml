<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="login-root" stylesheets="@../../styles/app.css,@../../styles/login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.SetNewPasswordController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-nav">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="nav-brand-block">
                <ImageView fitHeight="38" fitWidth="120" pickOnBounds="true" preserveRatio="true" styleClass="nav-logo-image">
                    <image>
                        <Image url="file:///C:/Users/comme/Desktop/PI/public/images/logo.png"/>
                    </image>
                </ImageView>
                <Region styleClass="nav-vsep"/>
            </HBox>
            <Region minWidth="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="6" styleClass="nav-center-links">
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavAccueil" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="♥"/>
                    <Label styleClass="nav-item-label" text="Accueil"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavProduits" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="🛒"/>
                    <Label styleClass="nav-item-label" text="Produits"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavRdv" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="🕐"/>
                    <Label styleClass="nav-item-label" text="Rendez-vous"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavEvents" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="📅"/>
                    <Label styleClass="nav-item-label" text="Événements"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onNavBlog" spacing="8" styleClass="nav-item">
                    <Label styleClass="nav-item-icon" text="📖"/>
                    <Label styleClass="nav-item-label" text="Blog"/>
                </HBox>
            </HBox>
            <Region minWidth="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Region styleClass="nav-vsep"/>
            <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="nav-trailing">
                <Button focusTraversable="false" onAction="#onToggleTheme" styleClass="icon-btn" text="🌙"/>
                <Hyperlink onAction="#onNavConnexion" styleClass="nav-link" text="Connexion"/>
                <Button onAction="#onRegister" styleClass="signup-btn" text="S'inscrire">
                    <graphic>
                        <Label styleClass="signup-btn-icon" text="👤"/>
                    </graphic>
                </Button>
                <HBox alignment="CENTER_LEFT" spacing="6" styleClass="nav-lang-row">
                    <Label styleClass="nav-icon-symbol" text="🌐"/>
                    <ComboBox fx:id="langCombo" prefWidth="72" styleClass="lang-combo"/>
                </HBox>
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" styleClass="login-center">
            <HBox alignment="CENTER" maxWidth="920" prefHeight="520" styleClass="login-card">
                <VBox maxWidth="Infinity" styleClass="login-card-left" HBox.hgrow="SOMETIMES">
                    <Label styleClass="welcome-label" text="Welcome!"/>
                    <Region minHeight="12" VBox.vgrow="ALWAYS"/>
                    <ImageView fitWidth="220" preserveRatio="true">
                        <image>
                            <Image url="file:///C:/Users/comme/Desktop/PI/public/images/logo.png"/>
                        </image>
                    </ImageView>
                    <Region minHeight="12" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox maxWidth="Infinity" spacing="14" styleClass="login-card-right" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-title" text="Set new password"/>
                    <Label styleClass="form-sub" text="Choose a new password for your account." wrapText="true"/>
                    <VBox spacing="6">
                        <Label styleClass="field-label" text="NEW PASSWORD (*)"/>
                        <PasswordField fx:id="newPasswordField" promptText="At least 8 characters" styleClass="text-input-field"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label fx:id="ruleLenLabel" styleClass="signup-hint pwd-rule" text="- Au moins 8 caractères"/>
                        <Label fx:id="ruleUpperLabel" styleClass="signup-hint pwd-rule" text="- Au moins une lettre majuscule"/>
                        <Label fx:id="ruleDigitLabel" styleClass="signup-hint pwd-rule" text="- Au moins un chiffre"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label styleClass="field-label" text="CONFIRM PASSWORD (*)"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" styleClass="text-input-field"/>
                    </VBox>
                    <Button maxWidth="Infinity" onAction="#onResetPassword" styleClass="login-primary-btn" text="Reset password"/>
                    <Hyperlink alignment="CENTER" maxWidth="Infinity" onAction="#onBack" styleClass="link-muted forgot-back-link" text="Back"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <VBox styleClass="login-page-footer">
            <Separator styleClass="login-footer-sep"/>
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="login-footer-copy" text="© 2026 AutiCare — Écouter · Aider · Accompagner"/>
        </VBox>
    </bottom>
</BorderPane>

