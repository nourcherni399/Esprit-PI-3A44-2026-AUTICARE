<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="0" styleClass="blog-page-root"
      stylesheets="@../../styles/page-blog.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PageBlogController">

    <!-- ══════ HERO ══════ -->
    <StackPane fx:id="heroBand" maxWidth="Infinity" styleClass="blog-hero-band">
        <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="blog-hero-bg-layer" />
        <HBox alignment="CENTER" maxWidth="Infinity" styleClass="blog-hero-inner">
            <StackPane maxWidth="1060" HBox.hgrow="ALWAYS" styleClass="blog-hero-card-shell">
                <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="blog-hero-card-bg" />
                <StackPane styleClass="blog-hero-card-stack">
                    <VBox alignment="CENTER" spacing="16" styleClass="blog-hero-text-col" StackPane.alignment="CENTER">
                        <StackPane alignment="CENTER" styleClass="blog-hero-icon-ring">
                            <ImageView fitHeight="80" fitWidth="80" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../images/blog/hero-icon.png" /></image>
                            </ImageView>
                        </StackPane>
                        <Label styleClass="blog-hero-title" text="Modules &amp; Témoignages" textAlignment="CENTER" wrapText="true" />
                        <Label styleClass="blog-hero-subtitle" text="Explorez nos modules d'apprentissage par catégorie. Partagez vos expériences, découvrez des conseils pratiques et rejoignez notre communauté." textAlignment="CENTER" wrapText="true" />
                    </VBox>
                    <ImageView fitWidth="240" pickOnBounds="false" preserveRatio="true" styleClass="blog-hero-illustration" StackPane.alignment="TOP_RIGHT">
                        <image><Image url="@../../images/blog/hero-enfants.png" /></image>
                    </ImageView>
                </StackPane>
            </StackPane>
        </HBox>
    </StackPane>

    <!-- ══════ ZONE DYNAMIQUE : catégories OU détail ══════ -->
    <StackPane fx:id="blogContentHost" maxWidth="Infinity" VBox.vgrow="ALWAYS">

        <!-- ─── VUE 1 : grille catégories pleine largeur ─── -->
        <VBox fx:id="categoriesView" alignment="TOP_CENTER" spacing="0" maxWidth="Infinity">
            <HBox alignment="TOP_CENTER" maxWidth="1060" styleClass="blog-main-row">
                <VBox alignment="TOP_LEFT" spacing="16" HBox.hgrow="ALWAYS">
                    <Label styleClass="blog-cats-heading" text="Catégories" />
                    <FlowPane fx:id="categoryCardsPane" hgap="18" vgap="18" styleClass="blog-cats-flow" />
                </VBox>
            </HBox>
        </VBox>

        <!-- ─── VUE 2 : détail d'une catégorie (modules) ─── -->
        <VBox fx:id="categoryDetailView" alignment="TOP_CENTER" spacing="0" maxWidth="Infinity" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" maxWidth="1060" styleClass="blog-detail-topbar">
                <Button onAction="#onBackToCategories" styleClass="blog-back-btn" text="← Retour aux catégories" />
            </HBox>

            <HBox alignment="CENTER_LEFT" maxWidth="1060" spacing="20" styleClass="blog-detail-header">
                <StackPane styleClass="blog-detail-header-img-wrap">
                    <ImageView fx:id="detailHeaderImg" fitWidth="120" fitHeight="120" pickOnBounds="true" preserveRatio="true" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="detailCatTitle" styleClass="blog-detail-cat-title" text="Catégorie" wrapText="true" />
                    <Label fx:id="detailCatDesc" styleClass="blog-detail-cat-desc" wrapText="true" />
                </VBox>
            </HBox>

            <FlowPane fx:id="moduleCardsPane" hgap="20" vgap="20" maxWidth="1060" styleClass="blog-modules-flow" />
        </VBox>

        <!-- ─── VUE 3 : détail d'un module ─── -->
        <VBox fx:id="moduleDetailView" alignment="TOP_CENTER" spacing="0" maxWidth="Infinity" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" maxWidth="1060" styleClass="blog-detail-topbar">
                <Button fx:id="backToCatBtn" onAction="#onBackToCategoryFromModule" styleClass="blog-back-btn" text="← Retour au blog" />
            </HBox>

            <HBox alignment="TOP_LEFT" maxWidth="1060" spacing="20" styleClass="blog-module-detail-row">
                <!-- Colonne gauche : contenu du module (40%) -->
                <VBox alignment="TOP_LEFT" spacing="16" prefWidth="400" minWidth="340" styleClass="blog-module-detail-left">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label fx:id="mdTitle" styleClass="blog-md-title" text="Titre" wrapText="true" />
                        <Label fx:id="mdNiveauBadge" styleClass="blog-md-niveau-badge" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="mdDate" styleClass="blog-md-date" />
                        <Button styleClass="blog-md-action-btn" text="▶" />
                        <Button styleClass="blog-md-action-btn" text="⬇" />
                        <Button styleClass="blog-md-action-btn" text="↗" />
                    </HBox>
                    <Label fx:id="mdDescription" styleClass="blog-md-desc" wrapText="true" />
                    <ImageView fx:id="mdImage" fitWidth="360" pickOnBounds="true" preserveRatio="true" styleClass="blog-md-image" />
                    <Label fx:id="mdContenu" styleClass="blog-md-contenu" wrapText="true" />

                    <Label text="Ressources du module" styleClass="blog-md-section-title" />

                    <!-- Ressources affichées APRÈS le titre -->
                    <VBox fx:id="mdRessourcesContainer" spacing="12" styleClass="blog-md-ressources-container">
                        <Label fx:id="mdRessources" styleClass="blog-md-ressources-text" text="Aucune ressource active pour ce module." wrapText="true" />
                    </VBox>

                    <Button text="🎓 Passer le quiz" styleClass="blog-md-quiz-btn" />

                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Hyperlink styleClass="blog-md-link" text="En savoir plus sur ce module  ↗" />
                    </HBox>

                    <!-- Icônes sociales (visible seulement si connecté) -->
                    <HBox fx:id="socialIconsBar" alignment="CENTER_LEFT" spacing="12" styleClass="blog-md-social-bar" visible="false" managed="false">
                        <Label text="♥" styleClass="blog-md-social-icon" />
                        <Label fx:id="addArticleBtn" text="＋" styleClass="blog-md-social-icon" onMouseClicked="#onToggleArticleForm" />
                        <Label text="➜" styleClass="blog-md-social-icon" />
                    </HBox>

                    <!-- Message de connexion (si non connecté) -->
                    <HBox fx:id="loginPromptBox" alignment="CENTER" spacing="6" styleClass="blog-login-prompt-simple" visible="false" managed="false">
                        <Label text="Pour écrire un article, veuillez vous " styleClass="blog-login-prompt-simple-text" />
                        <Hyperlink fx:id="loginLink" text="connecter" styleClass="blog-login-prompt-simple-link" onAction="#onShowLogin" />
                        <Label text="." styleClass="blog-login-prompt-simple-text" />
                    </HBox>
                </VBox>

                <!-- Colonne droite : articles + formulaire (60%) -->
                <VBox alignment="TOP_LEFT" spacing="20" HBox.hgrow="ALWAYS" styleClass="blog-module-detail-right">

                    <!-- En-tête articles -->
                    <Label text="Articles publiés pour ce module" styleClass="blog-art-heading" />

                    <!-- Barre de recherche -->
                    <HBox alignment="CENTER_LEFT" styleClass="blog-art-search-bar">
                        <Label text="🔍" styleClass="blog-art-search-icon" />
                        <TextField fx:id="articleSearchField" promptText="Tapez un titre d'article..." styleClass="blog-art-search-field" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Liste articles -->
                    <VBox fx:id="mdArticlesContainer" alignment="TOP_CENTER" spacing="16" styleClass="blog-art-list">
                        <Label fx:id="mdArticlesPlaceholder" styleClass="blog-md-articles-empty" text="Aucun article publié pour ce module." wrapText="true" textAlignment="CENTER" />
                        <Label styleClass="blog-md-articles-hint" text="Soyez le premier à écrire un article !" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- Formulaire nouvel article (visible si connecté) -->
                    <VBox fx:id="articleFormContainer" alignment="TOP_LEFT" spacing="14" styleClass="blog-article-form-card" visible="false" managed="false">
                        <Label text="Nouvel article" styleClass="blog-form-heading" />

                        <VBox spacing="8" styleClass="blog-ai-section">
                            <Label text="Générer avec l'IA" styleClass="blog-ai-title" />
                            <Label text="Saisissez un prompt et sélectionnez un type pour que l'IA génère le titre et le contenu." styleClass="blog-ai-desc" wrapText="true" />
                            <Label text="Prompt / Sujet" styleClass="blog-form-label" />
                            <TextArea fx:id="aiPromptField" promptText="Ex. Témoignage sur les progrès avec les pictogrammes..." styleClass="blog-form-textarea-small" prefRowCount="2" wrapText="true" />
                            <Label text="Type d'article" styleClass="blog-form-label" />
                            <ComboBox fx:id="aiTypeCombo" promptText="-- Choisir --" maxWidth="Infinity" styleClass="blog-form-combo" />
                            <Button text="Générer titre et contenu" onAction="#onGenerateAI" styleClass="blog-ai-generate-btn" />
                        </VBox>

                        <Label text="Titre" styleClass="blog-form-label" />
                        <TextField fx:id="articleTitreField" promptText="Titre de l'article" styleClass="blog-form-textfield" />
                        <Label text="Type" styleClass="blog-form-label" />
                        <ComboBox fx:id="articleTypeCombo" promptText="Choisir un type" maxWidth="Infinity" styleClass="blog-form-combo" />
                        <Label text="Contenu" styleClass="blog-form-label" />
                        <TextArea fx:id="articleContenuField" promptText="Contenu de l'article..." styleClass="blog-form-textarea" prefRowCount="5" wrapText="true" />

                        <Label text="Image de l'article" styleClass="blog-form-label" />
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <RadioButton fx:id="rbUploadFile" text="Uploader un fichier" selected="true">
                                <toggleGroup><ToggleGroup fx:id="imageToggle" /></toggleGroup>
                            </RadioButton>
                            <RadioButton fx:id="rbPexels" text="Rechercher sur Pexels">
                                <toggleGroup><fx:reference source="imageToggle" /></toggleGroup>
                            </RadioButton>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="blog-form-file-row">
                            <Button text="Choisir un fichier" onAction="#onChooseArticleImage" styleClass="blog-form-file-btn" />
                            <Label fx:id="articleImageLabel" text="Aucun fichier choisi" styleClass="blog-form-file-label" />
                        </HBox>

                        <VBox spacing="6" styleClass="blog-hashtag-section">
                            <Label text="Générer des hashtags" styleClass="blog-hashtag-title" />
                            <Label text="Génère des hashtags à partir du titre. Ils seront ajoutés à la fin du contenu." styleClass="blog-hashtag-desc" wrapText="true" />
                            <Button text="Générer des hashtags" onAction="#onGenerateHashtags" styleClass="blog-ai-generate-btn" />
                        </VBox>

                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <CheckBox fx:id="cbPublished" text="Publier l'article" />
                            <CheckBox fx:id="cbUrgent" text="Urgent" />
                            <CheckBox fx:id="cbVisible" text="Visible" selected="true" />
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="Publier" onAction="#onPublishArticle" styleClass="blog-form-publish-btn" />
                            <Button text="Annuler" onAction="#onCancelArticle" styleClass="blog-form-cancel-btn" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- ─── VUE 4 : modifier un article ─── -->
        <VBox fx:id="editArticleView" alignment="TOP_CENTER" spacing="0" maxWidth="Infinity" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" maxWidth="1060" styleClass="blog-detail-topbar">
                <Button onAction="#onBackFromEdit" styleClass="blog-back-btn" text="← Retour au module" />
            </HBox>

            <VBox alignment="TOP_CENTER" maxWidth="700" styleClass="blog-edit-form-wrapper">
                <Label text="Modifier l'article" styleClass="blog-form-heading" />

                <VBox spacing="8" styleClass="blog-ai-section">
                    <Label text="Générer avec l'IA" styleClass="blog-ai-title" />
                    <Label text="Saisissez un prompt et sélectionnez un type pour que l'IA génère le titre et le contenu." styleClass="blog-ai-desc" wrapText="true" />
                    <Label text="Prompt / Sujet" styleClass="blog-form-label" />
                    <TextArea fx:id="editAiPromptField" promptText="Ex. Témoignage sur les progrès avec les pictogrammes..." styleClass="blog-form-textarea-small" prefRowCount="2" wrapText="true" />
                    <Label text="Type d'article" styleClass="blog-form-label" />
                    <ComboBox fx:id="editAiTypeCombo" promptText="-- Choisir --" maxWidth="Infinity" styleClass="blog-form-combo" />
                    <Button text="Générer titre et contenu" onAction="#onEditGenerateAI" styleClass="blog-ai-generate-btn" />
                </VBox>

                <Label text="Titre" styleClass="blog-form-label" />
                <TextField fx:id="editTitreField" promptText="Titre de l'article" styleClass="blog-form-textfield" />

                <Label text="Type" styleClass="blog-form-label" />
                <ComboBox fx:id="editTypeCombo" promptText="Choisir un type" maxWidth="Infinity" styleClass="blog-form-combo" />

                <Label text="Contenu" styleClass="blog-form-label" />
                <TextArea fx:id="editContenuField" promptText="Contenu de l'article..." styleClass="blog-form-textarea" prefRowCount="6" wrapText="true" />

                <Label text="Image de l'article" styleClass="blog-form-label" />
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <RadioButton fx:id="editRbUploadFile" text="Uploader un fichier" selected="true">
                        <toggleGroup><ToggleGroup fx:id="editImageToggle" /></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="editRbPexels" text="Rechercher sur Pexels">
                        <toggleGroup><fx:reference source="editImageToggle" /></toggleGroup>
                    </RadioButton>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="blog-form-file-row">
                    <Button text="Choisir un fichier" onAction="#onChooseEditImage" styleClass="blog-form-file-btn" />
                    <Label fx:id="editImageLabel" text="Aucun fichier choisi" styleClass="blog-form-file-label" />
                </HBox>

                <VBox spacing="6" styleClass="blog-hashtag-section">
                    <Label text="Générer des hashtags" styleClass="blog-hashtag-title" />
                    <Label text="Génère des hashtags à partir du titre. Ils seront ajoutés à la fin du contenu." styleClass="blog-hashtag-desc" wrapText="true" />
                    <Button text="Générer des hashtags" onAction="#onEditGenerateHashtags" styleClass="blog-ai-generate-btn" />
                </VBox>

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <CheckBox fx:id="editCbPublished" text="Publier l'article" />
                    <CheckBox fx:id="editCbUrgent" text="Urgent" />
                    <CheckBox fx:id="editCbVisible" text="Visible" selected="true" />
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="Enregistrer" onAction="#onSaveEditArticle" styleClass="blog-form-publish-btn" />
                    <Button text="Annuler" onAction="#onBackFromEdit" styleClass="blog-form-cancel-btn" />
                </HBox>
            </VBox>
        </VBox>

    </StackPane>
</VBox>
